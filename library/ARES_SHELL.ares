$ @mod ARES_SHELL

# \file ARES_SHELL.ares
# \info The shell's library, imported bare by every `ares shell` session.
#       The `@shell_*` builtins are the operations of the built-in `<@Shell>`
#       effect: the shell performs them, so they work only there, and a
#       program that calls one does not type-check. `type` and `scope` print
#       what the `<@Meta>` reflection finds, which the shell can run because
#       it runs at compile time.

$ @import IO
$ @import STR

# Leave the shell, forget the session, print the session.
$ @shell_quit : {} -> <@Shell> {} = @extern "ares"
$ @shell_reset : {} -> <@Shell> {} = @extern "ares"
$ @shell_list : {} -> <@Shell> {} = @extern "ares"

# Leave the shell.
$ quit : {} -> <@Shell> {} = \_ => @shell_quit {}

# Forget every import and definition.
$ reset : {} -> <@Shell> {} = \_ => @shell_reset {}

# Print the session's imports and definitions.
$ list : {} -> <@Shell> {} = \_ => @shell_list {}

# Print the shell's help.
$ help : {} -> <@IO> {} = \_ => for help_text <| \line => println line

# The shell's help, a line per element.
$ help_text : @Vec @Str = [
    "The shell reads Ares `$` items, like a `.ares` file. Each prompt opens with a",
    "fixed `$ ` and a deletable `_= ` prefill. Enter submits the whole buffer at once.",
    "Ctrl-J starts a new line, so items may span lines; type `$` then Ctrl-J to submit",
    "the item you are editing. An evaluated item's value is reported on a `#` comment",
    "line, with its type.",
    "",
    "  $ _= <expr>       evaluate an expression and print its value and type",
    "  $ name : T = <e>  add (or redefine) a binding (silent, like a file)",
    "  $ @import MOD        import a standard-library module (e.g. VEC, STR, MATH)",
    "  $ @e <| <code>    run compile-time code, and add the items it returns",
    "",
    "Every session imports ARES_SHELL:",
    "  $ _= type \"1 + 2\"    print an expression's type (or a name's declared type)",
    "  $ _= scope \"vec\"     print the names in scope containing `vec`, with types",
    "  $ _= list {}         print the imports and definitions",
    "  $ _= reset {}        clear all imports and definitions",
    "  $ _= help {}         print this help",
    "  $ _= quit {}         leave the shell (or Ctrl-D)",
    "",
    "The shell runs at compile time, so the `<@Meta>` operations those use work at",
    "the prompt too (`@scope`, `@type_of`, `@lookup`, `@check`, ...).",
    "",
    "Emacs editing keys:",
    "  C-b/C-f (or arrows) character    M-b/M-f word      C-p/C-n (or Up/Down) line",
    "  C-a/C-e line start/end           M-</M-> item start/end",
    "  C-v/M-v page down/up             C-l clear screen",
    "  C-k kill to end of line          M-d/M-DEL kill next/previous word (C-w = M-DEL)",
    "  Delete delete the char at the cursor",
    "  C-d end of input: leave the shell",
    "  C-c abandon the item being edited (and stop a running evaluation)",
    "  C-z suspend the shell (resume it with `fg`)",
    "  C-/ undo                         M-/ redo",
    "  C-r reverse history search: type to match, C-r/Up older, C-n/Down newer,",
    "      Enter to accept, Esc (or C-g) to cancel",
    "  C-j new line (or submit the item when it ends in `$`)",
]

# Print the type of `src`: a global's declared type, `@use` fields and all, or
# else the type the expression `src` checks at, without running it.
$ type : @Str -> <@Meta, @IO> {} = \src =>
    let ty = @lookup src |> \ | Decl.Value.{ ty } => ty | _ => @check <| @parse_str src in
    println <| src ++ " : " ++ ty

# Print every name in scope that contains `part`, with its type. `scope ""`
# prints them all.
$ scope : @Str -> <@Meta, @IO> {} = \part =>
    for
        (@scope {}) <| \{ name, ty } =>
            when (STR.contains name part) <| \_ => println <| name ++ " : " ++ ty
