@mod MATH

# \file MATH.thx
# \info Integer helpers, Real helpers, and the libm functions (wrapped from
#       the auto-injected `C` namespace). Predicates return @bool.
#       `min`/`max`/`abs`/`clamp` are each ONE generic definition over CORE's
#       comparison and arithmetic interfaces, so they work for any type that has
#       them, not just @int and Real. `pow` is the named spelling of CORE's `^`.

# One definition each, over any ordered type.
$ min : @ctx IOrd t -> t -> t -> t = \d, a, b = if d.lt b a => b else a
$ max : @ctx IOrd t -> t -> t -> t = \d, a, b = if d.lt a b => b else a

# `x` forced into [lo, hi].
$ clamp : @ctx IOrd t -> t -> t -> t -> t = \d, lo, hi, x =
	max (@ctx d) lo (min (@ctx d) hi x)

# The distance from zero, for any type that is ordered and can subtract.
$ abs : @ctx {IOrd t, ISub t, IZero t} -> t -> t = \ds, x =
	if ds.0.lt x ds.2.zero => ds.1.sub ds.2.zero x else x

# Three-way comparison: negative / 0 / positive (the ordering MAP.new_int
# uses).
$ cmp_int : @int -> @int -> @int = \a, b =
	if a < b => 0 - 1 else if a > b => 1 else 0

$ sign : @int -> @int = \n =
	if n < 0 => 0 - 1 else if n > 0 => 1 else 0

$ even : @int -> @bool = \n = (abs n) % 2 == 0
$ odd  : @int -> @bool = \n = !(even n)

$ gcd : @int -> @int -> @int = \a, b =
	if b == 0 => abs a else gcd b (a % b)

# `pow` is the named spelling of `^`, over CORE's `IPow`: integer exponentiation is
# repeated multiplication (a negative exponent yields 0, integer-division
# semantics), the real one is libm's.
$ pow : @ctx IPow t -> t -> t -> t = \d, b, e = d.raise b e

# ---- int <-> real conversions ----
# `@cast` crosses only integer widths; these bridge the integer/real boundary
# (a plain numeric cast in the engine runtime). `f32`/`int_of_f32` target the
# 32-bit reals that C graphics APIs use.
$ real_of_int : @int -> Real     = \n = C.i2d n
$ int_of_real : Real -> @int     = \x = C.d2i x
$ f32_of_int  : @int -> @float32 = \n = C.i2f n
$ int_of_f32  : @float32 -> @int = \x = C.f2i x

# ---- Real helpers ----

$ pi : Real = 3.141592653589793
$ euler : Real = 2.718281828459045

# ---- libm (via the C namespace) ----

$ sqrt : Real -> Real = \x = C.sqrt x
$ sin  : Real -> Real = \x = C.sin x
$ cos  : Real -> Real = \x = C.cos x
$ tan  : Real -> Real = \x = C.tan x
$ exp  : Real -> Real = \x = C.exp x
$ log  : Real -> Real = \x = C.log x
$ floor : Real -> Real = \x = C.floor x
$ ceil  : Real -> Real = \x = C.ceil x
$ round : Real -> Real = \x = C.round x

$ fmod : Real -> Real -> Real = \a, b = C.fmod {a, b}
$ atan2 : Real -> Real -> Real = \y, x = C.atan2 {y, x}
