@mod CPX

# \file CPX.thx
# \info Complex-number math over CORE's `Cpx`. The type, the `i` literal and
#       `+ - * /` live in CORE (implicitly imported, so `3.4 + 1.2i` needs no
#       import); everything here is the rest of the surface: parts, polar form,
#       roots, and the transcendentals, all ordinary Thrax over libm through the
#       `C` namespace.

$ with MATH

# ---- constants ----

# `zero` and `one` double as LA's element dictionary (with `add`/`mul` below), so
# `dot`/`matmul` reduce a `[n]Cpx` with no tensor-side support.
$ zero : Cpx = Cpx.{ 0.0, 0.0 }
$ one  : Cpx = Cpx.{ 1.0, 0.0 }

# The rest of LA's element dictionary. The operators do the work; these only give
# the arithmetic the names `@ctx` resolves by.
$ add : Cpx -> Cpx -> Cpx = \a b = a + b
$ mul : Cpx -> Cpx -> Cpx = \a b = a * b

# ---- parts and predicates ----

$ re : Cpx -> Real = \z = z.re
$ im : Cpx -> Real = \z = z.im

$ of_real : Real -> Cpx = \x = Cpx.{ x, 0.0 }

$ conj : Cpx -> Cpx = \z = Cpx.{ z.re, 0.0 - z.im }

# `|z|`, via libm `hypot` so a large component does not overflow the squares.
$ abs : Cpx -> Real = \z = C.hypot {z.re, z.im}

# `|z|^2`. Cheaper than `abs` and exact for exactly-representable parts, which
# is why comparisons and `recip` use it.
$ norm : Cpx -> Real = \z = z.re * z.re + z.im * z.im

# The principal argument, in (-pi, pi].
$ arg : Cpx -> Real = \z = C.atan2 {z.im, z.re}

$ is_real : Cpx -> @bool = \z = z.im == 0.0
$ is_zero : Cpx -> @bool = \z = z.re == 0.0 && z.im == 0.0

# ---- scaling and inversion ----

$ scale : Real -> Cpx -> Cpx = \k z = Cpx.{ k * z.re, k * z.im }

$ recip : Cpx -> Cpx = \z = let d = norm z in Cpx.{ z.re / d, (0.0 - z.im) / d }

# Smith's division: it scales by the smaller of the divisor's parts, so it keeps
# its range where CORE's `/` (which forms `|b|^2` directly) would overflow.
$ div_smith : Cpx -> Cpx -> Cpx = \a b =
	if MATH.abs b.re >= MATH.abs b.im
		=> let r = b.im / b.re,
		       d = b.re + b.im * r
			in Cpx.{ (a.re + a.im * r) / d, (a.im - a.re * r) / d }
		else let r = b.re / b.im,
		         d = b.re * r + b.im
			  in Cpx.{ (a.re * r + a.im) / d, (a.im * r - a.re) / d }

# ---- polar form ----

$ polar : Cpx -> {Real, Real} = \z = {abs z, arg z}

$ from_polar : Real -> Real -> Cpx = \r theta =
	Cpx.{ r * MATH.cos theta, r * MATH.sin theta }

# ---- transcendentals ----

# `exp z = e^x (cos y + i sin y)`.
$ exp : Cpx -> Cpx = \z =
	let m = MATH.exp z.re in
	Cpx.{ m * MATH.cos z.im, m * MATH.sin z.im }

# The principal branch: the imaginary part is `arg z`, so it lies in (-pi, pi].
$ log : Cpx -> Cpx = \z = Cpx.{ MATH.log (abs z), arg z }

# The principal square root, from the polar form at half the argument.
$ sqrt : Cpx -> Cpx = \z =
	let r = MATH.sqrt (abs z) in
	let half = arg z / 2.0 in
	Cpx.{ r * MATH.cos half, r * MATH.sin half }

# `z^w = exp (w * log z)`, principal branch. `0^0` is 1, as for reals.
$ pow : Cpx -> Cpx -> Cpx = \z w =
	if is_zero z => (if is_zero w => one else zero)
	else exp (w * log z)

$ powi : Cpx -> @int -> Cpx = \z n =
	if n < 0 => recip (powi z (0 - n))
	else if n == 0 => one
	else z * powi z (n - 1)

$ (^) : Cpx -> @int -> Cpx = \z n = powi z n
$ (^) : Cpx -> Cpx -> Cpx = \z w = pow z w

$ sin : Cpx -> Cpx = \z =
	Cpx.{ MATH.sin z.re * C.cosh z.im, MATH.cos z.re * C.sinh z.im }

$ cos : Cpx -> Cpx = \z =
	Cpx.{ MATH.cos z.re * C.cosh z.im, 0.0 - (MATH.sin z.re * C.sinh z.im) }

$ tan : Cpx -> Cpx = \z = sin z / cos z

$ sinh : Cpx -> Cpx = \z =
	Cpx.{ C.sinh z.re * MATH.cos z.im, C.cosh z.re * MATH.sin z.im }

$ cosh : Cpx -> Cpx = \z =
	Cpx.{ C.cosh z.re * MATH.cos z.im, C.sinh z.re * MATH.sin z.im }

$ tanh : Cpx -> Cpx = \z = sinh z / cosh z

# ---- roots ----

# The `n`th roots of unity, counter-clockwise from 1. Empty for `n <= 0`.
$ roots_of_unity : @int -> @vec Cpx = \n = roots_onto (@vec_new {}) 1.0 0.0 n 0

# The `n` `n`th roots of `z`, counter-clockwise from the principal one. Empty for
# `n <= 0`.
$ roots : Cpx -> @int -> @vec Cpx = \z n =
	let r = MATH.pow (abs z) (1.0 / C.i2d n) in
	roots_onto (@vec_new {}) r (arg z / C.i2d n) n 0

$ @private

# The roots share one loop: `n` points on the circle of radius `r`, starting at
# `base` and stepping by a full turn over `n`.
$ roots_onto : @vec Cpx -> Real -> Real -> @int -> @int -> @vec Cpx = \acc r base n k =
	if k >= n => acc
	else
		let step = 2.0 * MATH.pi * C.i2d k / C.i2d n in
		roots_onto (@vec_push acc (from_polar r (base + step))) r base n (k + 1)
