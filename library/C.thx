$ @mod C

# \file library/C.thx
# \info The auto-injected `C` namespace: the standard C library (libc + libm) as
#       `@extern` bindings, reachable qualified (`C.sqrt`, `C.malloc`, ...) with
#       no import, like the prelude. Each binding is an ordinary foreign
#       function, so it flows through the single FFI path: the interpreter's
#       host table and the C backend's direct symbol call.
#
#       A C function has no first-class closure to curry, so a Thrax `@extern`
#       takes EXACTLY ONE argument: a one-parameter C function is `A -> B`, and a
#       multi-parameter one groups its C parameters into a record, `{a: A, b: B}
#       -> R`, whose fields, in declaration order, are the positional C
#       arguments. A nullary C function takes unit, `{} -> R`.
#
#       How values cross the seam: `@Int` is a machine word (also an int-typed C
#       argument, a `FILE*` handle, and a file descriptor), `@Ptr` is a raw heap
#       pointer (from `C.malloc`), `@Str` is a byte string (the FFI copies it and
#       appends a NUL for the call, so it reaches C as a `char*`), `@Float64` is a double,
#       and `{}` is unit -- as an argument it means the C function takes no value there
#       (a `void` parameter, e.g. `C.getchar {}`), as a result it is `void`.

# -- math.h (libm) ---------------------------------------------------------
$ sqrt : @Float64 -> @Float64 = @extern "C" "sqrt" "libm"
$ cbrt : @Float64 -> @Float64 = @extern "C" "cbrt" "libm"
$ sin : @Float64 -> @Float64 = @extern "C" "sin" "libm"
$ cos : @Float64 -> @Float64 = @extern "C" "cos" "libm"
$ tan : @Float64 -> @Float64 = @extern "C" "tan" "libm"
$ asin : @Float64 -> @Float64 = @extern "C" "asin" "libm"
$ acos : @Float64 -> @Float64 = @extern "C" "acos" "libm"
$ atan : @Float64 -> @Float64 = @extern "C" "atan" "libm"
$ sinh : @Float64 -> @Float64 = @extern "C" "sinh" "libm"
$ cosh : @Float64 -> @Float64 = @extern "C" "cosh" "libm"
$ tanh : @Float64 -> @Float64 = @extern "C" "tanh" "libm"
$ exp : @Float64 -> @Float64 = @extern "C" "exp" "libm"
$ exp2 : @Float64 -> @Float64 = @extern "C" "exp2" "libm"
$ log : @Float64 -> @Float64 = @extern "C" "log" "libm"
$ log2 : @Float64 -> @Float64 = @extern "C" "log2" "libm"
$ log10 : @Float64 -> @Float64 = @extern "C" "log10" "libm"
$ fabs : @Float64 -> @Float64 = @extern "C" "fabs" "libm"
$ floor : @Float64 -> @Float64 = @extern "C" "floor" "libm"
$ ceil : @Float64 -> @Float64 = @extern "C" "ceil" "libm"
$ round : @Float64 -> @Float64 = @extern "C" "round" "libm"
$ trunc : @Float64 -> @Float64 = @extern "C" "trunc" "libm"
$ pow : { base: @Float64, exp: @Float64 } -> @Float64 = @extern "C" "pow" "libm"
$ fmod : { x: @Float64, y: @Float64 } -> @Float64 = @extern "C" "fmod" "libm"
$ atan2 : { y: @Float64, x: @Float64 } -> @Float64 = @extern "C" "atan2" "libm"
$ hypot : { x: @Float64, y: @Float64 } -> @Float64 = @extern "C" "hypot" "libm"
$ copysign : { mag: @Float64, sgn: @Float64 } -> @Float64 = @extern "C" "copysign" "libm"
$ fmin : { a: @Float64, b: @Float64 } -> @Float64 = @extern "C" "fmin" "libm"
$ fmax : { a: @Float64, b: @Float64 } -> @Float64 = @extern "C" "fmax" "libm"
$ fdim : { a: @Float64, b: @Float64 } -> @Float64 = @extern "C" "fdim" "libm"

# -- stdlib.h --------------------------------------------------------------
$ malloc : @Int -> @Ptr = @extern "C" "malloc" "libc"
$ calloc : { count: @Int, size: @Int } -> @Ptr = @extern "C" "calloc" "libc"
$ realloc : { ptr: @Ptr, size: @Int } -> @Ptr = @extern "C" "realloc" "libc"
$ free : @Ptr -> {} = @extern "C" "free" "libc"
$ atoi : @Str -> @Int = @extern "C" "atoi" "libc"
$ atof : @Str -> @Float64 = @extern "C" "atof" "libc"
$ rand : {} -> <@IO> @Int = @extern "C" "rand" "libc"
$ srand : @Int -> <@IO> {} = @extern "C" "srand" "libc"
$ exit : @Int -> <@IO> {} = @extern "C" "exit" "libc"
$ abort : {} -> <@IO> {} = @extern "C" "abort" "libc"
$ system : @Str -> <@IO> @Int = @extern "C" "system" "libc"

# -- string.h --------------------------------------------------------------
$ strlen : @Str -> @Int = @extern "C" "strlen" "libc"
$ strcmp : { a: @Str, b: @Str } -> @Int = @extern "C" "strcmp" "libc"
$ strncmp : { a: @Str, b: @Str, n: @Int } -> @Int = @extern "C" "strncmp" "libc"
$ strchr : { s: @Str, c: @Int } -> @Ptr = @extern "C" "strchr" "libc"
$ strrchr : { s: @Str, c: @Int } -> @Ptr = @extern "C" "strrchr" "libc"
$ strstr : { haystack: @Str, needle: @Str } -> @Ptr = @extern "C" "strstr" "libc"
$ memcpy : { dst: @Ptr, src: @Ptr, n: @Int } -> @Ptr = @extern "C" "memcpy" "libc"
$ memmove : { dst: @Ptr, src: @Ptr, n: @Int } -> @Ptr = @extern "C" "memmove" "libc"
$ memset : { dst: @Ptr, c: @Int, n: @Int } -> @Ptr = @extern "C" "memset" "libc"
$ memcmp : { a: @Ptr, b: @Ptr, n: @Int } -> @Int = @extern "C" "memcmp" "libc"
$ memchr : { s: @Ptr, c: @Int, n: @Int } -> @Ptr = @extern "C" "memchr" "libc"

# -- ctype.h ---------------------------------------------------------------
$ isalpha : @Int -> @Int = @extern "C" "isalpha" "libc"
$ isdigit : @Int -> @Int = @extern "C" "isdigit" "libc"
$ isalnum : @Int -> @Int = @extern "C" "isalnum" "libc"
$ isspace : @Int -> @Int = @extern "C" "isspace" "libc"
$ isupper : @Int -> @Int = @extern "C" "isupper" "libc"
$ islower : @Int -> @Int = @extern "C" "islower" "libc"
$ ispunct : @Int -> @Int = @extern "C" "ispunct" "libc"
$ iscntrl : @Int -> @Int = @extern "C" "iscntrl" "libc"
$ isprint : @Int -> @Int = @extern "C" "isprint" "libc"
$ toupper : @Int -> @Int = @extern "C" "toupper" "libc"
$ tolower : @Int -> @Int = @extern "C" "tolower" "libc"

# -- stdio.h ---------------------------------------------------------------
# A `FILE*` handle travels as an `@Int` (the pointer as a word); fopen returns 0
# on failure. Console/fd I/O uses `C.write` (fd 1 = stdout, 2 = stderr).
$ puts : @Str -> <@IO> @Int = @extern "C" "puts" "libc"
$ putchar : @Int -> <@IO> @Int = @extern "C" "putchar" "libc"
$ getchar : {} -> <@IO> @Int = @extern "C" "getchar" "libc"
$ fopen : { path: @Str, mode: @Str } -> <@IO> @Int = @extern "C" "fopen" "libc"
$ fclose : @Int -> <@IO> @Int = @extern "C" "fclose" "libc"
$ fgetc : @Int -> <@IO> @Int = @extern "C" "fgetc" "libc"
$ fputc : { c: @Int, stream: @Int } -> <@IO> @Int = @extern "C" "fputc" "libc"
$ fputs : { s: @Str, stream: @Int } -> <@IO> @Int = @extern "C" "fputs" "libc"
$ fwrite : { buf: @Str, size: @Int, n: @Int, stream: @Int } -> <@IO> @Int =
    @extern "C" "fwrite" "libc"
$ fflush : @Int -> <@IO> @Int = @extern "C" "fflush" "libc"
$ fseek : { stream: @Int, off: @Int, whence: @Int } -> <@IO> @Int = @extern "C" "fseek" "libc"
$ ftell : @Int -> <@IO> @Int = @extern "C" "ftell" "libc"
$ remove : @Str -> <@IO> @Int = @extern "C" "remove" "libc"
$ rename : { from: @Str, to: @Str } -> <@IO> @Int = @extern "C" "rename" "libc"

# A command's pipe, as the same `@Int` FILE* handle; mode is "r" or "w", 0 on
# failure. `pclose` (not `fclose`) closes one, and returns the command's wait
# status. The command runs under the platform's shell (`sh`, or `cmd.exe` on
# Windows), so a portable program avoids shell syntax.
$ popen : { cmd: @Str, mode: @Str } -> <@IO> @Int = @extern "C" "popen" "libc"
$ pclose : @Int -> <@IO> @Int = @extern "C" "pclose" "libc"

# -- unistd.h / time.h -----------------------------------------------------
$ write : { fd: @Int, buf: @Str, n: @Int } -> <@IO> @Int = @extern "C" "write" "libc"
$ getenv : @Str -> <@IO> @Str = @extern "C" "getenv" "libc"
$ time : @Int -> <@IO> @Int = @extern "C" "time" "libc"
$ clock : {} -> <@IO> @Int = @extern "C" "clock" "libc"

# -- engine intrinsics -----------------------------------------------------
# NOT libc: the interpreter serves these from a compiled-in host table, and the
# native backend defines them in runtime.c, which is INLINED into the one .c it
# emits (same translation unit, not a separate library). So no external library
# satisfies these symbols: the name is empty ("" => nothing to dlopen or `-l`).
# `@cast` crosses only integer widths, so these bridge the int/real and
# int/pointer boundaries it cannot. MATH re-exports the numeric ones as
# `real_of_int` / `int_of_real` / ...
$ i2d : @Int -> @Float64 = @extern "C" "thx_i2d" ""
$ d2i : @Float64 -> @Int = @extern "C" "thx_d2i" ""
$ i2f : @Int -> @Float32 = @extern "C" "thx_i2f" ""
$ f2i : @Float32 -> @Int = @extern "C" "thx_f2i" ""

# A pointer travels as a machine word; `i2p` reinterprets one, and `null` is the
# null pointer (the language has no `@Ptr` literal). For C APIs taking an
# optional `T*` you want to pass as NULL.
$ i2p : @Int -> @Ptr = @extern "C" "thx_i2p" ""
$ null : @Ptr = i2p 0

# A directory's entry names, one per line, `.` and `..` excluded, unsorted; ""
# when it cannot be opened. `IO.read_dir` is the friendly form.
$ dir_entries : @Str -> <@IO> @Str = @extern "C" "thx_read_dir" ""
