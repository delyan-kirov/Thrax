$ (-) : @nat64 -> @nat -> @nat64 = \a b = let x : @nat64 = @cast b in @isub a x
$ (*) : @nat64 -> @nat -> @nat64 = \a b = let x : @nat64 = @cast b in @imul a x
$ (/) : @nat64 -> @nat -> @nat64 = \a b = let x : @nat64 = @cast b in @udiv a x
