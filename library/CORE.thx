$ (-) : @int16 -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @isub x b
$ (*) : @int16 -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @imul x b
$ (/) : @int16 -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @idiv x b
$ (%) : @int16 -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @imod x b

$ (+) : @int16 -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @iadd x b
$ (-) : @int16 -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @isub x b
$ (*) : @int16 -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @imul x b
