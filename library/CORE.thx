@mod CORE

# \file CORE.thx
# \info CORE is implicitly imported in every module with no namespace 

# Arithmetic operators. Each is an overload over a machine intrinsic (`@iadd`,
# `@fadd`, ...); the resolver picks by operand type. This is why `+ - * / %` are
# not special-cased in the compiler. Signed integers and @nat share add/sub/mul
# (two's complement), but @nat divides unsigned (`@udiv`/`@umod`). Floats use the
# `@f*` family. (`^`, comparisons, and `++` are still compiler builtins, pending
# their own intrinsics.)

# `Real` is a friendly alias for the word-size float `@float64`; the compiler knows
# only `@float64`, not `Real`.
$ Real : @alias = @float64

# @int / @nat: the word-size integer types. The word-size float `@float64` (its
# friendly alias `Real`) is defined below with the other floats.
$ (+) : @int -> @int -> @int = \a b = @iadd a b
$ (-) : @int -> @int -> @int = \a b = @isub a b
$ (*) : @int -> @int -> @int = \a b = @imul a b
$ (/) : @int -> @int -> @int = \a b = @idiv a b
$ (%) : @int -> @int -> @int = \a b = @imod a b
# 
$ (+) : @nat -> @nat -> @nat = \a b = @iadd a b
$ (-) : @nat -> @nat -> @nat = \a b = @isub a b
$ (*) : @nat -> @nat -> @nat = \a b = @imul a b
$ (/) : @nat -> @nat -> @nat = \a b = @udiv a b
$ (%) : @nat -> @nat -> @nat = \a b = @umod a b
# Sized signed integers (same intrinsics as @int; each a DISTINCT type).
$ (+) : @int8 -> @int8 -> @int8 = \a b = @iadd a b
$ (-) : @int8 -> @int8 -> @int8 = \a b = @isub a b
$ (*) : @int8 -> @int8 -> @int8 = \a b = @imul a b
$ (/) : @int8 -> @int8 -> @int8 = \a b = @idiv a b
$ (%) : @int8 -> @int8 -> @int8 = \a b = @imod a b

$ (+) : @int16 -> @int16 -> @int16 = \a b = @iadd a b
$ (-) : @int16 -> @int16 -> @int16 = \a b = @isub a b
$ (*) : @int16 -> @int16 -> @int16 = \a b = @imul a b
$ (/) : @int16 -> @int16 -> @int16 = \a b = @idiv a b
$ (%) : @int16 -> @int16 -> @int16 = \a b = @imod a b

$ (+) : @int32 -> @int32 -> @int32 = \a b = @iadd a b
$ (-) : @int32 -> @int32 -> @int32 = \a b = @isub a b
$ (*) : @int32 -> @int32 -> @int32 = \a b = @imul a b
$ (/) : @int32 -> @int32 -> @int32 = \a b = @idiv a b
$ (%) : @int32 -> @int32 -> @int32 = \a b = @imod a b

$ (+) : @int64 -> @int64 -> @int64 = \a b = @iadd a b
$ (-) : @int64 -> @int64 -> @int64 = \a b = @isub a b
$ (*) : @int64 -> @int64 -> @int64 = \a b = @imul a b
$ (/) : @int64 -> @int64 -> @int64 = \a b = @idiv a b
$ (%) : @int64 -> @int64 -> @int64 = \a b = @imod a b
# Sized nats (unsigned div/mod).
$ (+) : @nat8 -> @nat8 -> @nat8 = \a b = @iadd a b
$ (-) : @nat8 -> @nat8 -> @nat8 = \a b = @isub a b
$ (*) : @nat8 -> @nat8 -> @nat8 = \a b = @imul a b
$ (/) : @nat8 -> @nat8 -> @nat8 = \a b = @udiv a b
$ (%) : @nat8 -> @nat8 -> @nat8 = \a b = @umod a b

$ (+) : @nat16 -> @nat16 -> @nat16 = \a b = @iadd a b
$ (-) : @nat16 -> @nat16 -> @nat16 = \a b = @isub a b
$ (*) : @nat16 -> @nat16 -> @nat16 = \a b = @imul a b
$ (/) : @nat16 -> @nat16 -> @nat16 = \a b = @udiv a b
$ (%) : @nat16 -> @nat16 -> @nat16 = \a b = @umod a b

$ (+) : @nat32 -> @nat32 -> @nat32 = \a b = @iadd a b
$ (-) : @nat32 -> @nat32 -> @nat32 = \a b = @isub a b
$ (*) : @nat32 -> @nat32 -> @nat32 = \a b = @imul a b
$ (/) : @nat32 -> @nat32 -> @nat32 = \a b = @udiv a b
$ (%) : @nat32 -> @nat32 -> @nat32 = \a b = @umod a b

$ (+) : @nat64 -> @nat64 -> @nat64 = \a b = @iadd a b
$ (-) : @nat64 -> @nat64 -> @nat64 = \a b = @isub a b
$ (*) : @nat64 -> @nat64 -> @nat64 = \a b = @imul a b
$ (/) : @nat64 -> @nat64 -> @nat64 = \a b = @udiv a b
$ (%) : @nat64 -> @nat64 -> @nat64 = \a b = @umod a b
# Sized floats.
$ (+) : @float32 -> @float32 -> @float32 = \a b = @f32add a b
$ (-) : @float32 -> @float32 -> @float32 = \a b = @f32sub a b
$ (*) : @float32 -> @float32 -> @float32 = \a b = @f32mul a b
$ (/) : @float32 -> @float32 -> @float32 = \a b = @f32div a b
$ (%) : @float32 -> @float32 -> @float32 = \a b = @f32mod a b

$ (+) : @float64 -> @float64 -> @float64 = \a b = @fadd a b
$ (-) : @float64 -> @float64 -> @float64 = \a b = @fsub a b
$ (*) : @float64 -> @float64 -> @float64 = \a b = @fmul a b
$ (/) : @float64 -> @float64 -> @float64 = \a b = @fdiv a b
$ (%) : @float64 -> @float64 -> @float64 = \a b = @fmod a b
# Float width conversions. Unlike integers, `@float32` and `@float64` differ in
# runtime representation, so widening is genuine work: these bind the C runtime
# helpers (`thx_f2d`/`thx_d2f`) through the same `@extern` seam as `C.i2d`.
$ f32_to_f64 : @float32 -> @float64 = @extern "C" "thx_f2d" ""
$ f64_to_f32 : @float64 -> @float32 = @extern "C" "thx_d2f" ""
# Mixed-width floats: result is the wider `@float64`, the `@float32` operand
# widened first. (`@cast` cannot do this: it only reinterprets integer widths.)
$ (+) : @float32 -> @float64 -> @float64 = \a b = @fadd (f32_to_f64 a) b
$ (-) : @float32 -> @float64 -> @float64 = \a b = @fsub (f32_to_f64 a) b
$ (*) : @float32 -> @float64 -> @float64 = \a b = @fmul (f32_to_f64 a) b
$ (/) : @float32 -> @float64 -> @float64 = \a b = @fdiv (f32_to_f64 a) b
$ (%) : @float32 -> @float64 -> @float64 = \a b = @fmod (f32_to_f64 a) b

$ (+) : @float64 -> @float32 -> @float64 = \a b = @fadd a (f32_to_f64 b)
$ (-) : @float64 -> @float32 -> @float64 = \a b = @fsub a (f32_to_f64 b)
$ (*) : @float64 -> @float32 -> @float64 = \a b = @fmul a (f32_to_f64 b)
$ (/) : @float64 -> @float32 -> @float64 = \a b = @fdiv a (f32_to_f64 b)
$ (%) : @float64 -> @float32 -> @float64 = \a b = @fmod a (f32_to_f64 b)
# Mixed-width signed integers: result = the wider operand, narrower cast up.
# (@int/@nat/Real are NOT auto-widened: target-dependent width. Floats are not
# here: `@cast` is integer-only.)
$ (+) : @int8 -> @int16 -> @int16 = \a b = let x : @int16 = @cast a in @iadd x b
$ (-) : @int8 -> @int16 -> @int16 = \a b = let x : @int16 = @cast a in @isub x b
$ (*) : @int8 -> @int16 -> @int16 = \a b = let x : @int16 = @cast a in @imul x b
$ (/) : @int8 -> @int16 -> @int16 = \a b = let x : @int16 = @cast a in @idiv x b
$ (%) : @int8 -> @int16 -> @int16 = \a b = let x : @int16 = @cast a in @imod x b

$ (+) : @int8 -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @iadd x b
$ (-) : @int8 -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @isub x b
$ (*) : @int8 -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @imul x b
$ (/) : @int8 -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @idiv x b
$ (%) : @int8 -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @imod x b

$ (+) : @int8 -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @iadd x b
$ (-) : @int8 -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @isub x b
$ (*) : @int8 -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @imul x b
$ (/) : @int8 -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @idiv x b
$ (%) : @int8 -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @imod x b

$ (+) : @int16 -> @int8 -> @int16 = \a b = let x : @int16 = @cast b in @iadd a x
$ (-) : @int16 -> @int8 -> @int16 = \a b = let x : @int16 = @cast b in @isub a x
$ (*) : @int16 -> @int8 -> @int16 = \a b = let x : @int16 = @cast b in @imul a x
$ (/) : @int16 -> @int8 -> @int16 = \a b = let x : @int16 = @cast b in @idiv a x
$ (%) : @int16 -> @int8 -> @int16 = \a b = let x : @int16 = @cast b in @imod a x

