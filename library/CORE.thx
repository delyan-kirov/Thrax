$ (*) : @int32 -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @imul x b
$ (/) : @int32 -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @idiv x b
$ (%) : @int32 -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @imod x b

$ (+) : @int64 -> @int8 -> @int64 = \a b = let x : @int64 = @cast b in @iadd a x
$ (-) : @int64 -> @int8 -> @int64 = \a b = let x : @int64 = @cast b in @isub a x
$ (*) : @int64 -> @int8 -> @int64 = \a b = let x : @int64 = @cast b in @imul a x
$ (/) : @int64 -> @int8 -> @int64 = \a b = let x : @int64 = @cast b in @idiv a x
$ (%) : @int64 -> @int8 -> @int64 = \a b = let x : @int64 = @cast b in @imod a x

