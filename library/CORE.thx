$ (-) : @nat -> @nat16 -> @nat16 = \a b = let x : @nat16 = @cast a in @isub x b
$ (*) : @nat -> @nat16 -> @nat16 = \a b = let x : @nat16 = @cast a in @imul x b
$ (/) : @nat -> @nat16 -> @nat16 = \a b = let x : @nat16 = @cast a in @udiv x b
$ (%) : @nat -> @nat16 -> @nat16 = \a b = let x : @nat16 = @cast a in @umod x b

$ (+) : @nat16 -> @nat -> @nat16 = \a b = let x : @nat16 = @cast b in @iadd a x
$ (-) : @nat16 -> @nat -> @nat16 = \a b = let x : @nat16 = @cast b in @isub a x
$ (*) : @nat16 -> @nat -> @nat16 = \a b = let x : @nat16 = @cast b in @imul a x
$ (/) : @nat16 -> @nat -> @nat16 = \a b = let x : @nat16 = @cast b in @udiv a x
$ (%) : @nat16 -> @nat -> @nat16 = \a b = let x : @nat16 = @cast b in @umod a x

$ (+) : @nat -> @nat32 -> @nat32 = \a b = let x : @nat32 = @cast a in @iadd x b
$ (-) : @nat -> @nat32 -> @nat32 = \a b = let x : @nat32 = @cast a in @isub x b
$ (*) : @nat -> @nat32 -> @nat32 = \a b = let x : @nat32 = @cast a in @imul x b
$ (/) : @nat -> @nat32 -> @nat32 = \a b = let x : @nat32 = @cast a in @udiv x b
$ (%) : @nat -> @nat32 -> @nat32 = \a b = let x : @nat32 = @cast a in @umod x b

$ (+) : @nat32 -> @nat -> @nat32 = \a b = let x : @nat32 = @cast b in @iadd a x
$ (-) : @nat32 -> @nat -> @nat32 = \a b = let x : @nat32 = @cast b in @isub a x
$ (*) : @nat32 -> @nat -> @nat32 = \a b = let x : @nat32 = @cast b in @imul a x
$ (/) : @nat32 -> @nat -> @nat32 = \a b = let x : @nat32 = @cast b in @udiv a x
