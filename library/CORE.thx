$ to_string : Str -> Str = \s = s

$ to_string : @bool -> Str = \b = if b => "true" else "false"

$ to_string : Int -> Str = \n =
	if n ?< 0 => "-" ++ to_string_digits (0 - n) ""
	else to_string_digits n ""

$ to_string_digits : Int -> Str -> Str = \n acc =
	if n ?< 10 => (@array_push "" (48 + n)) ++ acc
	else to_string_digits (n / 10) ((@array_push "" (48 + n % 10)) ++ acc)

# `Nat` prints unsigned: it divides with `@udiv`/`@umod` so a value above the
# signed range still renders correctly. A single digit fits an `Int`, so `@cast`
# each one down before appending it as a byte.
$ to_string_udigit : Nat -> Int = \n = @cast n

$ to_string_udigits : Nat -> Str -> Str = \n acc =
	if n ?< 10 => (@array_push "" (48 + to_string_udigit n)) ++ acc
	else to_string_udigits (n / 10) ((@array_push "" (48 + to_string_udigit (n % 10))) ++ acc)

$ to_string : Nat -> Str = \n = to_string_udigits n ""

# The sized integers reuse the friendly-type printers: `@cast` to `Int` (signed)
# or `Nat` (unsigned) is an erased width reinterpret, so the value is unchanged.
$ to_string : @int8  -> Str = \x = to_string (let n : Int = @cast x in n)
$ to_string : @int16 -> Str = \x = to_string (let n : Int = @cast x in n)
$ to_string : @int32 -> Str = \x = to_string (let n : Int = @cast x in n)
$ to_string : @int64 -> Str = \x = to_string (let n : Int = @cast x in n)

$ to_string : @nat8  -> Str = \x = to_string (let n : Nat = @cast x in n)
$ to_string : @nat16 -> Str = \x = to_string (let n : Nat = @cast x in n)
$ to_string : @nat32 -> Str = \x = to_string (let n : Nat = @cast x in n)
$ to_string : @nat64 -> Str = \x = to_string (let n : Nat = @cast x in n)

# `from_string` is the inverse of `to_string`: parse text back into a value. It
# reads bytes with `@array_get`/`@array_len`, so it stays in the language.
$ from_string : Str -> Str = \s = s

$ from_string : Str -> @bool = \s = s ?= "true"

$ from_string_digits : Str -> Int -> Int -> Int = \s i acc =
	if i ?= @array_len s => acc
	else from_string_digits s (i + 1) (acc * 10 + (@array_get s i - 48))

$ from_string : Str -> Int = \s =
	if @array_len s ?= 0 => 0
	else if @array_get s 0 ?= 45 => 0 - from_string_digits s 1 0
	else from_string_digits s 0 0

# Floats serialize through the C runtime: `thx_real_to_str`/`thx_f32_to_str`
# format the shortest round-tripping decimal (the same rule as display), and
# libc `atof` parses one back. `@float32` widens/narrows via the conversions above.
$ to_string : Real     -> Str = @extern "C" "thx_real_to_str" ""
$ to_string : @float64 -> Str = @extern "C" "thx_real_to_str" ""
$ to_string : @float32 -> Str = @extern "C" "thx_f32_to_str" ""

$ from_string : Str -> Real     = @extern "C" "atof" "libc"
$ from_string : Str -> @float64 = @extern "C" "atof" "libc"
$ from_string : Str -> @float32 = \s = let d : @float64 = from_string s in f64_to_f32 d

$ from_string : Str -> Nat    = \s = let n : Int = from_string s in let m : Nat    = @cast n in m
$ from_string : Str -> @int8  = \s = let n : Int = from_string s in let m : @int8  = @cast n in m
$ from_string : Str -> @int16 = \s = let n : Int = from_string s in let m : @int16 = @cast n in m
$ from_string : Str -> @int32 = \s = let n : Int = from_string s in let m : @int32 = @cast n in m
$ from_string : Str -> @int64 = \s = let n : Int = from_string s in let m : @int64 = @cast n in m
$ from_string : Str -> @nat8  = \s = let n : Nat = from_string s in let m : @nat8  = @cast n in m
$ from_string : Str -> @nat16 = \s = let n : Nat = from_string s in let m : @nat16 = @cast n in m
$ from_string : Str -> @nat32 = \s = let n : Nat = from_string s in let m : @nat32 = @cast n in m
$ from_string : Str -> @nat64 = \s = let n : Nat = from_string s in let m : @nat64 = @cast n in m

# The expression-form range `[lo ... hi]` desugars to `range lo hi`: the inclusive
# list of Ints from `lo` to `hi` (empty when `lo > hi`). It builds a `@list`, since
# the length is a runtime value (not a statically sized `[n]T` tensor).
$ range : Int -> Int -> @list Int = \lo hi =
	if lo ?> hi => []
	else lo :: range (lo + 1) hi

# The canonical infinite stream: coinductive data observed by `.head` (the current
# element) and `.tail` (the rest). Non-memoized thunks, so it is genuinely infinite.
$ Stream : @codata t = head : t, tail : Stream t,

# The open range `[lo ...]` desugars to `count_from lo`: the ascending Ints from
# `lo` upward, with no end. It builds a `Stream`, the only shape that can hold an
# unbounded sequence (not a finite `@list` or a statically sized `[n]T`).
$ count_from : Int -> Stream Int = \lo = { .head = lo, .tail = count_from (lo + 1) }
