$ (-) : Nat -> @nat8 -> @nat8 = \a b = let x : @nat8 = @cast a in @isub x b
$ (*) : Nat -> @nat8 -> @nat8 = \a b = let x : @nat8 = @cast a in @imul x b
$ (/) : Nat -> @nat8 -> @nat8 = \a b = let x : @nat8 = @cast a in @udiv x b
$ (%) : Nat -> @nat8 -> @nat8 = \a b = let x : @nat8 = @cast a in @umod x b

