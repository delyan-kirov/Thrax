$ (%) : @int -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @imod x b

$ (+) : @int32 -> @int -> @int32 = \a b = let x : @int32 = @cast b in @iadd a x
$ (-) : @int32 -> @int -> @int32 = \a b = let x : @int32 = @cast b in @isub a x
$ (*) : @int32 -> @int -> @int32 = \a b = let x : @int32 = @cast b in @imul a x
$ (/) : @int32 -> @int -> @int32 = \a b = let x : @int32 = @cast b in @idiv a x
$ (%) : @int32 -> @int -> @int32 = \a b = let x : @int32 = @cast b in @imod a x

$ (+) : @int -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @iadd x b
$ (-) : @int -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @isub x b
$ (*) : @int -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @imul x b
$ (/) : @int -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @idiv x b
$ (%) : @int -> @int64 -> @int64 = \a b = let x : @int64 = @cast a in @imod x b

$ (+) : @int64 -> @int -> @int64 = \a b = let x : @int64 = @cast b in @iadd a x
$ (-) : @int64 -> @int -> @int64 = \a b = let x : @int64 = @cast b in @isub a x
$ (*) : @int64 -> @int -> @int64 = \a b = let x : @int64 = @cast b in @imul a x
$ (/) : @int64 -> @int -> @int64 = \a b = let x : @int64 = @cast b in @idiv a x
$ (%) : @int64 -> @int -> @int64 = \a b = let x : @int64 = @cast b in @imod a x

$ (+) : @nat -> @nat8 -> @nat8 = \a b = let x : @nat8 = @cast a in @iadd x b
$ (-) : @nat -> @nat8 -> @nat8 = \a b = let x : @nat8 = @cast a in @isub x b
$ (*) : @nat -> @nat8 -> @nat8 = \a b = let x : @nat8 = @cast a in @imul x b
$ (/) : @nat -> @nat8 -> @nat8 = \a b = let x : @nat8 = @cast a in @udiv x b
$ (%) : @nat -> @nat8 -> @nat8 = \a b = let x : @nat8 = @cast a in @umod x b

$ (+) : @nat8 -> @nat -> @nat8 = \a b = let x : @nat8 = @cast b in @iadd a x
$ (-) : @nat8 -> @nat -> @nat8 = \a b = let x : @nat8 = @cast b in @isub a x
$ (*) : @nat8 -> @nat -> @nat8 = \a b = let x : @nat8 = @cast b in @imul a x
$ (/) : @nat8 -> @nat -> @nat8 = \a b = let x : @nat8 = @cast b in @udiv a x
$ (%) : @nat8 -> @nat -> @nat8 = \a b = let x : @nat8 = @cast b in @umod a x

