# `@int`/`@nat` (the machine-word default integers) mixed with a sized integer:
# the sized type wins and the word operand casts to it, so a bare literal (which
# defaults to `@int`/`@nat`) drops into sized arithmetic without widening the
# result. Signed `@int` pairs with `@int*`, unsigned `@nat` with `@nat*`.
$ (+) : @int -> @int8 -> @int8 = \a b = let x : @int8 = @cast a in @iadd x b
$ (-) : @int -> @int8 -> @int8 = \a b = let x : @int8 = @cast a in @isub x b
$ (*) : @int -> @int8 -> @int8 = \a b = let x : @int8 = @cast a in @imul x b
$ (/) : @int -> @int8 -> @int8 = \a b = let x : @int8 = @cast a in @idiv x b
$ (%) : @int -> @int8 -> @int8 = \a b = let x : @int8 = @cast a in @imod x b

$ (+) : @int8 -> @int -> @int8 = \a b = let x : @int8 = @cast b in @iadd a x
$ (-) : @int8 -> @int -> @int8 = \a b = let x : @int8 = @cast b in @isub a x
$ (*) : @int8 -> @int -> @int8 = \a b = let x : @int8 = @cast b in @imul a x
$ (/) : @int8 -> @int -> @int8 = \a b = let x : @int8 = @cast b in @idiv a x
$ (%) : @int8 -> @int -> @int8 = \a b = let x : @int8 = @cast b in @imod a x

$ (+) : @int -> @int16 -> @int16 = \a b = let x : @int16 = @cast a in @iadd x b
$ (-) : @int -> @int16 -> @int16 = \a b = let x : @int16 = @cast a in @isub x b
$ (*) : @int -> @int16 -> @int16 = \a b = let x : @int16 = @cast a in @imul x b
$ (/) : @int -> @int16 -> @int16 = \a b = let x : @int16 = @cast a in @idiv x b
$ (%) : @int -> @int16 -> @int16 = \a b = let x : @int16 = @cast a in @imod x b

$ (+) : @int16 -> @int -> @int16 = \a b = let x : @int16 = @cast b in @iadd a x
$ (-) : @int16 -> @int -> @int16 = \a b = let x : @int16 = @cast b in @isub a x
$ (*) : @int16 -> @int -> @int16 = \a b = let x : @int16 = @cast b in @imul a x
$ (/) : @int16 -> @int -> @int16 = \a b = let x : @int16 = @cast b in @idiv a x
$ (%) : @int16 -> @int -> @int16 = \a b = let x : @int16 = @cast b in @imod a x

$ (+) : @int -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @iadd x b
$ (-) : @int -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @isub x b
$ (*) : @int -> @int32 -> @int32 = \a b = let x : @int32 = @cast a in @imul x b
