$ (-) : @nat16 -> @nat32 -> @nat32 = \a b = let x : @nat32 = @cast a in @isub x b
$ (*) : @nat16 -> @nat32 -> @nat32 = \a b = let x : @nat32 = @cast a in @imul x b
$ (/) : @nat16 -> @nat32 -> @nat32 = \a b = let x : @nat32 = @cast a in @udiv x b
