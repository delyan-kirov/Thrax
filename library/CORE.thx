$ (-) : @int64 -> @int16 -> @int64 = \a b = let x : @int64 = @cast b in @isub a x
$ (*) : @int64 -> @int16 -> @int64 = \a b = let x : @int64 = @cast b in @imul a x
$ (/) : @int64 -> @int16 -> @int64 = \a b = let x : @int64 = @cast b in @idiv a x
$ (%) : @int64 -> @int16 -> @int64 = \a b = let x : @int64 = @cast b in @imod a x

$ (+) : @int64 -> @int32 -> @int64 = \a b = let x : @int64 = @cast b in @iadd a x
$ (-) : @int64 -> @int32 -> @int64 = \a b = let x : @int64 = @cast b in @isub a x
$ (*) : @int64 -> @int32 -> @int64 = \a b = let x : @int64 = @cast b in @imul a x
$ (/) : @int64 -> @int32 -> @int64 = \a b = let x : @int64 = @cast b in @idiv a x
