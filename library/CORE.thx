$ (*) : @nat8 -> @nat32 -> @nat32 = \a b = let x : @nat32 = @cast a in @imul x b
$ (/) : @nat8 -> @nat32 -> @nat32 = \a b = let x : @nat32 = @cast a in @udiv x b
