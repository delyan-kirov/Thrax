$ (-) : @nat -> @nat64 -> @nat64 = \a b = let x : @nat64 = @cast a in @isub x b
$ (*) : @nat -> @nat64 -> @nat64 = \a b = let x : @nat64 = @cast a in @imul x b
$ (/) : @nat -> @nat64 -> @nat64 = \a b = let x : @nat64 = @cast a in @udiv x b
$ (%) : @nat -> @nat64 -> @nat64 = \a b = let x : @nat64 = @cast a in @umod x b

