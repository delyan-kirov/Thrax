$ (-) : @nat8 -> @nat64 -> @nat64 = \a b = let x : @nat64 = @cast a in @isub x b
$ (*) : @nat8 -> @nat64 -> @nat64 = \a b = let x : @nat64 = @cast a in @imul x b
