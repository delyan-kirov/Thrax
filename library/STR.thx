$ @mod STR

# \file STR.thx
# \info String operations over the byte-vector `@Str` (see
#       documentation/strings-and-arrays.md; indices are 0-based BYTE offsets, `at`
#       returns a byte as an @Int in 0..255). The primitive layer --
#       `@array_len` / `@array_get` / `@array_slice` / `@array_push` / `++` /
#       `==` -- already works on `@Str`; this module builds the searching,
#       splitting and formatting layer on top of it.

$ with OPT
$ with VEC

$ len : @Str -> @Int = \s = @array_len s

$ at : @Str -> @Int -> @Int = \s i = @array_get s i

$ is_empty : @Str -> @Bool = \s = (@array_len s) == 0

$ eq : @Str -> @Str -> @Bool = \a b = a == b

# Three-way byte-lexicographic comparison: negative / 0 / positive (strcmp
# convention; this is the ordering MAP.new_str uses).
$ cmp_str : @Str -> @Str -> @Int = \a b = if a == b => 0 else if a < b => 0 - 1 else 1

# A one-byte string.
$ from_byte : @Int -> @Str = \c = @array_push "" c

# The byte range [from, to), clamped to the string.
$ substr : @Str -> @Int -> @Int -> @Str = \s from to = @array_slice s from to

$ starts_with : @Str -> @Str -> @Bool = \s p =
    let n = @array_len p in if n > @array_len s => @false else (@array_slice s 0 n) == p

$ ends_with : @Str -> @Str -> @Bool = \s p =
    let n = @array_len p in
    let sn = @array_len s in if n > sn => @false else (@array_slice s (sn - n) sn) == p

# The byte offset of the first occurrence of `needle` at or after `from`.
# An empty needle matches at `from`.
$ find_from : @Str -> @Str -> @Int -> Option @Int = \s needle from =
    let n = @array_len needle in
    if from + n > @array_len s => Option.None
    else if matches_at s needle from 0 => Option.Some.{ from }
    else find_from s needle (from + 1)

$ find : @Str -> @Str -> Option @Int = \s needle = find_from s needle 0

$ contains : @Str -> @Str -> @Bool = \s needle = is_some (find s needle)

# Split on a non-empty separator; N separators yield N+1 pieces ("a,,b" on
# "," is ["a", "", "b"]). An empty separator returns the whole string whole.
$ split : @Str -> @Str -> @Vec @Str = \s sep =
    if (@array_len sep) == 0 => [s] else split_onto (@vec_new {}) s sep 0 0

# The lines of `s`, split on '\n'. A trailing newline does not produce a
# final empty line.
$ lines : @Str -> @Vec @Str = \s =
    let n = @array_len s in
    if n == 0 => []
    else if (@array_get s (n - 1)) == 10 => split (@array_slice s 0 (n - 1)) "\n"
    else split s "\n"

$ join : @Str -> @Vec @Str -> @Str = \sep parts =
    is parts | h :: t => (is t | [] => h | _ => h ++ sep ++ join sep t) | _ => ""

$ repeat : @Str -> @Int -> @Str = \s n = if n <= 0 => "" else s ++ repeat s (n - 1)

$ concat : @Vec @Str -> @Str = \parts = join "" parts

# Pad with spaces to at least `width` bytes (no-op if already wider).
$ pad_left : @Str -> @Int -> @Str = \s width = repeat " " (width - @array_len s) ++ s

$ pad_right : @Str -> @Int -> @Str = \s width = s ++ repeat " " (width - @array_len s)

# Replace every (non-overlapping) occurrence; an empty needle returns `s`.
$ replace : @Str -> @Str -> @Str -> @Str = \s needle repl =
    if (@array_len needle) == 0 => s
    else
        is find s needle
        | Option.Some.{ i } =>
            let head : @Str = @array_slice s 0 i in
            let rest : @Str = @array_slice s (i + @array_len needle) (@array_len s) in
            head ++ repl ++ replace rest needle repl
        | _ => s

# Number of (non-overlapping) occurrences; an empty needle counts 0.
$ count : @Str -> @Str -> @Int = \s needle =
    if (@array_len needle) == 0 => 0
    else
        is find s needle
        | Option.Some.{ i } =>
            1 + count (@array_slice s (i + @array_len needle) (@array_len s)) needle
        | _ => 0

$ reverse : @Str -> @Str = \s = rev_onto s (@array_len s) ""

# ---- character (byte) predicates ----

$ is_space : @Int -> @Bool = \c = if c == 32 => @true else if c >= 9 => c <= 13 else @false

$ is_digit : @Int -> @Bool = \c = if c >= 48 => c <= 57 else @false

$ is_alpha : @Int -> @Bool = \c =
    if c >= 65 => (if c <= 90 => @true else if c >= 97 => c <= 122 else @false) else @false

$ is_alnum : @Int -> @Bool = \c = if is_digit c => @true else is_alpha c

$ is_upper : @Int -> @Bool = \c = if c >= 65 => c <= 90 else @false

$ is_lower : @Int -> @Bool = \c = if c >= 97 => c <= 122 else @false

# ---- trimming (ASCII whitespace) ----

$ trim_left : @Str -> @Str = \s =
    if (@array_len s) == 0 => s
    else if is_space (@array_get s 0) => trim_left (@array_slice s 1 (@array_len s))
    else s

$ trim_right : @Str -> @Str = \s =
    let n = @array_len s in
    if n == 0 => s
    else if is_space (@array_get s (n - 1)) => trim_right (@array_slice s 0 (n - 1))
    else s

$ trim : @Str -> @Str = \s = trim_left (trim_right s)

# ---- ASCII case ----

$ to_upper : @Str -> @Str = \s =
    map_bytes (\c = if c >= 97 => (if c <= 122 => c - 32 else c) else c) s

$ to_lower : @Str -> @Str = \s =
    map_bytes (\c = if c >= 65 => (if c <= 90 => c + 32 else c) else c) s

$ map_bytes : (@Int -> @Int) -> @Str -> @Str = \f s = map_bytes_from f s 0 ""

# ---- number formatting / parsing ----

$ from_int : @Int -> @Str = \n = if n < 0 => "-" ++ digits_of (0 - n) "" else digits_of n ""

# Parse a (possibly '-'-signed) run of decimal digits; anything else is None.
$ to_int : @Str -> Option @Int = \s =
    if (@array_len s) == 0 => Option.None
    else if (@array_get s 0) == 45 =>
        (if (@array_len s) == 1 => Option.None else opt_map (\n = 0 - n) (digits_val s 1 0))
    else digits_val s 0 0

# ---- internal recursion workers ----

$ @private

$ rev_onto : @Str -> @Int -> @Str -> @Str = \s i acc =
    if i == 0 => acc else rev_onto s (i - 1) (@array_push acc (@array_get s (i - 1)))

$ map_bytes_from : (@Int -> @Int) -> @Str -> @Int -> @Str -> @Str = \f s i acc =
    if i == @array_len s => acc
    else map_bytes_from f s (i + 1) (@array_push acc (f (@array_get s i)))

$ digits_of : @Int -> @Str -> @Str = \n acc =
    if n < 10 => (@array_push "" (48 + n)) ++ acc
    else digits_of (n / 10) ((@array_push "" (48 + n % 10)) ++ acc)

$ digits_val : @Str -> @Int -> @Int -> Option @Int = \s i acc =
    if i == @array_len s => Option.Some.{ acc }
    else
        let c = @array_get s i in
        if is_digit c => digits_val s (i + 1) (acc * 10 + (c - 48)) else Option.None

# Does `needle` occur in `s` at byte `at`, from needle byte `j` on? Compares in
# place, so a search allocates nothing per position.
$ matches_at : @Str -> @Str -> @Int -> @Int -> @Bool = \s needle at j =
    if j >= @array_len needle => @true
    else if (@array_get s (at + j)) == (@array_get needle j) => matches_at s needle at (j + 1)
    else @false

# The pieces of `s` cut at each `sep` (non-empty), pushed onto `acc` in order.
# `start` is where the current piece began; `i` is the next offset to test.
$ split_onto : @Vec @Str -> @Str -> @Str -> @Int -> @Int -> @Vec @Str = \acc s sep start i =
    let n = @array_len sep in
    if i + n > @array_len s => @vec_push acc (@array_slice s start (@array_len s))
    else if matches_at s sep i 0 =>
        split_onto (@vec_push acc (@array_slice s start i)) s sep (i + n) (i + n)
    else split_onto acc s sep start (i + 1)
