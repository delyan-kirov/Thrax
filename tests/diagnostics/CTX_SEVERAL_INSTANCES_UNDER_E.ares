$ @mod CTX_SEVERAL_INSTANCES_UNDER_E

# An ambiguous context under a compile-time check is reported as the ambiguity
# (#416).
$ Money : @struct = c: @Int,
$ impl_IAdd_for_Money : IAdd Money = .{ .add = \a b => Money.{ a.c + b.c } }
$ impl_IAdd_for_Money2 : IAdd Money = .{ .add = \a b => a }
$ m : Money = Money.{1} + Money.{2}  #~ error[TYPE_MISMATCH]: several values of type `IAdd Money` satisfy the context of `+`
$ &assert (m.c == 3) "m is 3"
