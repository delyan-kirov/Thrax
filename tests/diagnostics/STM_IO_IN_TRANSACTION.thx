$ @mod STM_IO_IN_TRANSACTION

# A transaction may run several times, so it cannot perform `@IO`: its row is
# `<Stm>` and nothing else.
$ with IO
$ with STM

$ bump : TVar @Int -> {} -> <@IO> {} = \t u =
	atomically (\w = println "bump"; modify t (\x = x + 1))  #~ error[TYPE_MISMATCH]: effect `@IO` is performed but not handled
