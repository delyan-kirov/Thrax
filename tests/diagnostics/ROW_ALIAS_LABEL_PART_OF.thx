$ @mod ROW_ALIAS_LABEL_PART_OF

# An unhandled label that came in through an alias names the alias.
$ Log : @effect = log : @Str -> {},
$ Gpu : @effect = draw : @Int -> {},
$ App : @alias = <Gpu, Log>

$ frame : @Int -> <App> @Int = \x = log "frame"; draw x; x
$ g : @Int -> <Gpu> @Int = \x = frame x  #~ error[TYPE_MISMATCH]: effect `Log` (part of `App`) is performed but not handled
