$ @mod RECOVERY

# One broken item does not hide the errors after it, and a use of a broken
# definition is not reported again.
$ h = \x = (x + 1  #~ error[UNEXPECTED_TOKEN]: expected ')' to close the group, found the next item

$ k : @int = h 3 + lenght [1]  #~ error[TYPE_UNBOUND]: unbound name `lenght`

$ f : @int -> @int = \x = x + "a"  #~ error[TYPE_MISMATCH]: expected @int, found @str

# `f` keeps its signature, so its callers still check against it.
$ g : @int = f 1 + 1

$ m : @str = 4  #~ error[TYPE_MISMATCH]: a numeric literal cannot be used where `@str` is expected
