$ @mod EFFECT_INSTANCE_MISMATCH

# A parameterized effect is used at one instance per handler: the parameter is
# fixed for every operation the handler serves.
$ Box : @effect a = take : @int -> a,

$ use : {} -> <Box> @int = \u =
	let s : @str = Box.take 0 in
	let n : @int = Box.take 1 in  #~ error[TYPE_MISMATCH]: expected @int, found @str
	n
