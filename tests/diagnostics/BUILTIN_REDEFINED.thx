$ @mod BUILTIN_REDEFINED

# The parser rewrites `|>` before any lookup, so a redefinition would be ignored.
$ (|>) : a -> (a -> b) -> b = \x f = f x  #~ error[DUPLICATE_SYMBOL]: `|>` is a builtin and cannot be redefined
$ not : @Bool -> @Bool = \b = b  #~ error[DUPLICATE_SYMBOL]: `not` is a builtin and cannot be redefined
