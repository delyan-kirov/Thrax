$ @mod PROMOTE_SCALAR_TO_OPEN_ROW

# An open row has no known field names, so there is nothing to promote a scalar into.
$ area : { x: @int, y: @int | r } -> @int = \p = p.x * p.y
$ a : @int = area 5  #~ error[TYPE_MISMATCH]: a numeric literal cannot be used where `{ x: @int, y: @int | a }` is expected
