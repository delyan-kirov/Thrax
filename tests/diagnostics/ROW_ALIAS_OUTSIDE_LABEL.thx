$ @mod ROW_ALIAS_OUTSIDE_LABEL

# A row alias admits exactly its own labels.
$ Log : @effect = log : @Str -> {},
$ Gpu : @effect = draw : @Int -> {},
$ Net : @effect = fetch : @Int -> @Int,
$ App : @alias = <Gpu, Log>

$ frame : @Int -> <App> @Int = \x = fetch x  #~ error[TYPE_MISMATCH]: effect `Net` is performed but not handled
