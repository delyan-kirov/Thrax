@mod ARRAYS_MUT

# Build a byte buffer by pushing; @array_push grows it (opportunistic in-place
# natively, copy-on-write when shared; the interpreter always copies).
$ build3 : @array =
	let a = @array.{ 0 } in
	let b = @array_push a 65 in
	let c = @array_push b 66 in
	@array_push c 67

$ ck_len : @int = if (@array_len build3) ?= 3 => 0 else 1
$ ck_0 : @int = if (@array_get build3 0) ?= 65 => 0 else 1
$ ck_2 : @int = if (@array_get build3 2) ?= 67 => 0 else 1

# @array_set replaces a byte; original semantics preserved (value returned).
$ setted : @array = @array_set (@array_push (@array_push (@array.{0}) 10) 20) 0 99
$ ck_set : @int = if (@array_get setted 0) ?= 99 => 0 else 1
$ ck_set1 : @int = if (@array_get setted 1) ?= 20 => 0 else 1

# @array_slice takes a subrange [start, end).
$ big : @array = @array_push (@array_push (@array_push (@array.{0}) 1) 2) 3
$ mid : @array = @array_slice big 1 3
$ ck_slice_len : @int = if (@array_len mid) ?= 2 => 0 else 1
$ ck_slice_0 : @int = if (@array_get mid 0) ?= 2 => 0 else 1

# Value semantics: pushing onto a shared array must not disturb the original.
$ base : @array = @array_push (@array.{0}) 7
$ grown : @array = @array_push base 8
$ ck_base_unchanged : @int = if (@array_len base) ?= 1 => 0 else 1
$ ck_ext : @int = if (@array_len grown) ?= 2 => 0 else 1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @int = ck_len + ck_0 + ck_2 + ck_set + ck_set1 + ck_slice_len + ck_slice_0 + ck_base_unchanged + ck_ext
