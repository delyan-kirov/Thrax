$ @mod VEC_IN_PLACE

# \file VEC_IN_PLACE.ares
# \info `@vec_push` and `@vec_set` update a vector in place when nothing else
#       holds it, so building one by pushes is linear. Every other holder must
#       still see the old contents: these checks keep a second reference alive
#       across each update in the ways one can arise.

$ Amb : @effect = flip : {} -> @Bool,

$ build : @Int -> @Vec @Int -> @Vec @Int = \n v => if n == 0 => v else build (n - 1) (@vec_push v n)

$ sum_from : @Int -> @Int -> @Vec @Int -> @Int = \i acc v =>
    if i == @vec_len v => acc else sum_from (i + 1) (acc + @vec_get v i) v

$ sum : @Vec @Int -> @Int = \v => sum_from 0 0 v

$ double_all : @Int -> @Vec @Int -> @Vec @Int = \i v =>
    if i == @vec_len v => v else double_all (i + 1) (@vec_set v i (2 * @vec_get v i))

# Unshared: every push and set lands in place.
$ ck_unique : @Int =
    let v = double_all 0 (build 1000 (@vec_new {})) in
    if @vec_len v == 1000 && sum v == 1001000 => 0 else 1

# The original stays readable after a push and a set on it.
$ ck_shared : @Int =
    let v = build 5 (@vec_new {}) in
    let w = @vec_push v 9 in
    let x = @vec_set v 0 99 in
    if @vec_len v == 5
        && @vec_get v 0 == 5
        && @vec_len w == 6
        && @vec_get w 5 == 9
        && @vec_get x 0 == 99 =>
        0
    else
        1

# Two pushes onto one vector with spare capacity: each gets its own copy.
$ ck_slack : @Int =
    let v = build 5 (@vec_new {}) in
    let a = @vec_push v 100 in
    let b = @vec_push v 200 in
    if @vec_get a 5 == 100 && @vec_get b 5 == 200 && @vec_len v == 5 => 0 else 1

# A partial application applied twice: the second push must not see the first.
$ ck_partial : @Int =
    let f = @vec_push (build 3 (@vec_new {})) in
    let a = f 7 in
    let b = f 8 in
    if @vec_len a == 4 && @vec_len b == 4 && @vec_get a 3 == 7 && @vec_get b 3 == 8 => 0 else 1

# A closure holding the vector, called twice.
$ ck_closure : @Int =
    let v = build 3 (@vec_new {}) in
    let g = \i => @vec_set v 0 i in
    let a = g 10 in
    let b = g 20 in
    if @vec_get a 0 == 10 && @vec_get b 0 == 20 && @vec_get v 0 == 3 => 0 else 1

$ sum_all : ({} -> <Amb> @Int) -> @Int = \body =>
    do body {}
    ctl k | Amb.flip u => k @true + k @false | x => x

# A continuation resumed twice: each branch pushes onto its own copy of `v`.
$ ck_multishot : @Int =
    let r =
        sum_all <| \u =>
            let v = build 3 (@vec_new {}) in
            let w = @vec_push v (if flip {} => 100 else 10) in
            sum w + @vec_len v
    in
    if r == 6 + 100 + 3 + 6 + 10 + 3 => 0 else 1

# The same with the vector's last use after the choice, so each resumed branch
# moves it: only the last resume may take it over.
$ ck_multishot_move : @Int =
    let r = sum_all <| \u =>
        let v = build 3 (@vec_new {}) in let x = if flip {} => 100 else 10 in sum (@vec_push v x) in
    if r == 6 + 100 + 6 + 10 => 0 else 1

$ test : @Int =
    ck_unique + ck_shared * 2 + ck_slack * 4 + ck_partial * 8 + ck_closure * 16 + ck_multishot * 32
        + ck_multishot_move * 64

$ &assert (test == 0) "VEC_IN_PLACE: a check failed"
