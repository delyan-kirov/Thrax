@mod WHEN_GUARDS

# \file when_guards.thx
# \info Guarded match arms: `is <pattern> if <guard> then <body>`. The guard is
#       a boolean tested in the scope of the pattern's bindings; when it fails,
#       the match falls through to the next arm -- even when the next arm shares
#       the same pattern or (for unions) the same constructor. Each `chk*` is 0
#       when correct and divides by zero (a runtime fault) when wrong, so a
#       regression makes this file fail loudly.

# --- Guards over a bound variable (literal-free) ------------------------------
# `is m if <guard>` binds the whole scrutinee, then tests it; two guarded arms
# fall through to each other and finally to `else`.
$ sgn : @int -> @int = \n =
	is n
		| m if m ?> 0 => 1
		| m if m ?< 0 => 0 - 1
		else 0

$ chk_sgn_p : @int = if sgn 7       ?= 1       => 0 else 1
$ chk_sgn_n : @int = if sgn (0 - 4) ?= (0 - 1) => 0 else 1
$ chk_sgn_0 : @int = if sgn 0       ?= 0       => 0 else 1

# --- Guards on the SAME struct pattern (the motivating example) ---------------
$ Pair : @struct =
	a: @int,
	b: @int,

$ cmp : Pair -> @int = \p =
	is p
		| Pair.{ a, b } if a ?> b => 0
		| Pair.{ a, b } if a ?= b => 1
		else 2

$ chk_cmp_gt : @int = if cmp Pair.{ .a = 3, .b = 1 } ?= 0 => 0 else 1
$ chk_cmp_eq : @int = if cmp Pair.{ .a = 2, .b = 2 } ?= 1 => 0 else 1
$ chk_cmp_lt : @int = if cmp Pair.{ .a = 1, .b = 3 } ?= 2 => 0 else 1

# --- Guards on the SAME union constructor (fallthrough across one tag) ---------
$ Box : @union =
	Some: @int,
	Nil: {},

$ grade : Box -> @int = \x =
	is x
		| Box.Some.{ v } if v ?> 100 => 3
		| Box.Some.{ v } if v ?> 0   => 2
		| Box.Some.{ _ }             => 1
		| Box.Nil.{}                 => 0
		else 0 - 1

$ chk_grade_big  : @int = if grade Box.Some.{ 500 }    ?= 3       => 0 else 1
$ chk_grade_pos  : @int = if grade Box.Some.{ 7 }      ?= 2       => 0 else 1
$ chk_grade_zero : @int = if grade Box.Some.{ 0 }      ?= 1       => 0 else 1
$ chk_grade_nil  : @int = if grade Box.Nil.{}          ?= 0       => 0 else 1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @int = chk_sgn_p + chk_sgn_n + chk_sgn_0 + chk_cmp_gt + chk_cmp_eq + chk_cmp_lt + chk_grade_big + chk_grade_pos + chk_grade_zero + chk_grade_nil
