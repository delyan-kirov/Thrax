@mod STDLIB_PATH

# \file STDLIB_PATH.thx
# \info POSIX path manipulation: basename/dirname (trailing slashes ignored,
#       "/" is its own base and dir), extensions without the dot, joining,
#       component splitting. Pure string code; no filesystem involved.

$ with PATH
$ with LIST
$ with STR

$ ck_base   : @int = if (basename "a/b/c.txt") ?= "c.txt" => 0 else 1
$ ck_base_sl: @int = if (basename "a/b/") ?= "b" => 0 else 1
$ ck_base_n : @int = if (basename "plain") ?= "plain" => 0 else 1
$ ck_base_r : @int = if (basename "/") ?= "/" => 0 else 1

$ ck_dir    : @int = if (dirname "a/b/c.txt") ?= "a/b" => 0 else 1
$ ck_dir_sl : @int = if (dirname "a/b//") ?= "a" => 0 else 1
$ ck_dir_n  : @int = if (dirname "plain") ?= "." => 0 else 1
$ ck_dir_a  : @int = if (dirname "/a") ?= "/" => 0 else 1
$ ck_dir_r  : @int = if (dirname "/") ?= "/" => 0 else 1

$ ck_ext    : @int = if (extension "a/b.txt") ?= "txt" => 0 else 1
$ ck_ext_n  : @int = if (extension "a.b/c") ?= "" => 0 else 1
$ ck_ext_dot: @int = if (extension ".bashrc") ?= "" => 0 else 1
$ ck_strip  : @int = if (strip_ext "a/b.txt") ?= "a/b" => 0 else 1
$ ck_strip_n: @int = if (strip_ext "a/b") ?= "a/b" => 0 else 1

$ ck_join   : @int = if (PATH.join "a" "b") ?= "a/b" => 0 else 1
$ ck_join_sl: @int = if (PATH.join "a/" "b") ?= "a/b" => 0 else 1
$ ck_join_r : @int = if (PATH.join "/" "a") ?= "/a" => 0 else 1
$ ck_join_ab: @int = if (PATH.join "a" "/etc") ?= "/etc" => 0 else 1
$ ck_join_mt: @int = if (PATH.join "" "b") ?= "b" => 0 else 1

$ ck_abs    : @int = if is_abs "/etc" => (if is_abs "etc" => 1 else 0) else 1
$ ck_parts  : @int = if (STR.join "," (parts "/a//b/")) ?= "a,b" => 0 else 1
$ ck_parts_n: @int = if (length (parts "")) ?= 0 => 0 else 1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @int = ck_base + ck_base_sl + ck_base_n + ck_base_r
	+ ck_dir + ck_dir_sl + ck_dir_n + ck_dir_a + ck_dir_r
	+ ck_ext + ck_ext_n + ck_ext_dot + ck_strip + ck_strip_n
	+ ck_join + ck_join_sl + ck_join_r + ck_join_ab + ck_join_mt
	+ ck_abs + ck_parts + ck_parts_n
