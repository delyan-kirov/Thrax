@mod STDLIB_LIST

# \file STDLIB_LIST.thx
# \info The standard library's VEC module: transformation, folding,
#       indexing and searching over the prelude's `@vec`. Operations that
#       need equality take it explicitly (dictionary passing).

$ with VEC
$ with OPT

$ xs : @vec @int = range 1 5 # [1, 2, 3, 4, 5]

$ ck_range  : @int = if (length xs) ?= 5 => 0 else 1
$ ck_sum    : @int = if (sum xs) ?= 15 => 0 else 1
$ ck_empty  : @int = if is_empty [] => 0 else 1
$ ck_map    : @int = if (sum (map (\x = x * 2) xs)) ?= 30 => 0 else 1
$ ck_filter : @int = if (length (filter (\x = x % 2 ?= 1) xs)) ?= 3 => 0 else 1
$ ck_foldl  : @int = if (foldl (\a x = a * 10 + x) 0 xs) ?= 12345 => 0 else 1
$ ck_foldr  : @int = if (foldr (\x a = x - a) 0 xs) ?= 3 => 0 else 1
$ ck_rev    : @int = if (foldl (\a x = a * 10 + x) 0 (reverse xs)) ?= 54321 => 0 else 1
$ ck_append : @int = if (length (append xs xs)) ?= 10 => 0 else 1
$ ck_concat : @int = if (sum (concat [xs, [10], []])) ?= 25 => 0 else 1
$ ck_take   : @int = if (sum (take 2 xs)) ?= 3 => 0 else 1
$ ck_drop   : @int = if (sum (drop 3 xs)) ?= 9 => 0 else 1
$ ck_nth    : @int = if (unwrap_or (nth xs 2) 0) ?= 3 => 0 else 1
$ ck_nth_off: @int = if is_none (nth xs 9) => 0 else 1
$ ck_set    : @int = if (sum (set_nth xs 0 100)) ?= 114 => 0 else 1
$ ck_any    : @int = if any (\x = x ?> 4) xs => 0 else 1
$ ck_all    : @int = if all (\x = x ?> 0) xs => 0 else 1
$ ck_find   : @int = if (unwrap_or (find (\x = x ?> 3) xs) 0) ?= 4 => 0 else 1
$ ck_has    : @int = if contains (\a b = a ?= b) 4 xs => 0 else 1
$ ck_zip    : @int =
	if (sum (map (\p = p.0 + p.1) (zip xs (reverse xs)))) ?= 30 => 0 else 1
$ ck_zipw   : @int = if (sum (zip_with (\a b = a * b) xs xs)) ?= 55 => 0 else 1
$ ck_unzip  : @int =
	let z = unzip (zip xs (reverse xs)) in
	if (sum z.0) + (sum z.1) ?= 30 => 0 else 1
$ ck_prod   : @int = if (product xs) ?= 120 => 0 else 1
$ ck_minmax : @int =
	if (minimum xs 0) ?= 1 => (if (maximum xs 0) ?= 5 => 0 else 1) else 1
$ ck_min_mt : @int = if (minimum [] 7) ?= 7 => 0 else 1
$ ck_last   : @int = if (unwrap_or (last xs) 0) ?= 5 => 0 else 1
$ ck_init   : @int = if (sum (init xs)) ?= 10 => 0 else 1
$ ck_repl   : @int = if (sum (replicate 4 3)) ?= 12 => 0 else 1
$ ck_inter  : @int = if (sum (intersperse 0 xs)) ?= 15 => 0 else 1
$ ck_intern : @int = if (length (intersperse 0 xs)) ?= 9 => 0 else 1
$ ck_takew  : @int = if (sum (take_while (\x = x ?< 3) xs)) ?= 3 => 0 else 1
$ ck_dropw  : @int = if (sum (drop_while (\x = x ?< 3) xs)) ?= 12 => 0 else 1
$ ck_span   : @int =
	let s = span (\x = x ?< 4) xs in
	if (sum s.0) ?= 6 => (if (sum s.1) ?= 9 => 0 else 1) else 1
$ ck_split  : @int =
	let s = split_at 2 xs in
	if (length s.0) ?= 2 => (if (sum s.1) ?= 12 => 0 else 1) else 1
$ ck_part   : @int =
	let s = partition (\x = x % 2 ?= 1) xs in
	if (sum s.0) ?= 9 => (if (sum s.1) ?= 6 => 0 else 1) else 1
$ ck_fmap   : @int =
	let halve = \x = if x % 2 ?= 0 => Option.Some.{ x / 2 } else Option.None in
	if (sum (filter_map halve xs)) ?= 3 => 0 else 1
$ ck_flat   : @int = if (sum (flat_map (\x = [x, x]) xs)) ?= 30 => 0 else 1
$ ck_rmfst  : @int = if (sum (remove_first (\x = x ?= 3) xs)) ?= 12 => 0 else 1
$ ck_index  : @int = if (unwrap_or (find_index (\x = x ?= 4) xs) 9) ?= 3 => 0 else 1
$ ck_lookup : @int =
	let eq = \a b = a ?= b in
	if (unwrap_or (lookup eq 2 (zip xs (reverse xs))) 0) ?= 4 => 0 else 1

# Sorting: stable merge sort under a three-way comparison.
$ ck_sort   : @int =
	let cmp = \a b = a - b in
	if (foldl (\a x = a * 10 + x) 0 (sort_by cmp [3, 1, 5, 2, 4])) ?= 12345
	=> 0 else 1
$ ck_sortrev: @int =
	let cmp = \a b = b - a in
	if (foldl (\a x = a * 10 + x) 0 (sort_by cmp xs)) ?= 54321 => 0 else 1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @int = ck_range + ck_sum + ck_empty + ck_map + ck_filter + ck_foldl
	+ ck_foldr + ck_rev + ck_append + ck_concat + ck_take + ck_drop
	+ ck_nth + ck_nth_off + ck_set + ck_any + ck_all + ck_find + ck_has
	+ ck_zip + ck_zipw + ck_unzip + ck_prod + ck_minmax + ck_min_mt
	+ ck_last + ck_init + ck_repl + ck_inter + ck_intern + ck_takew
	+ ck_dropw + ck_span + ck_split + ck_part + ck_fmap + ck_flat
	+ ck_rmfst + ck_index + ck_lookup + ck_sort + ck_sortrev
