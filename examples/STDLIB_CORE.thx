@mod STDLIB_CORE

# \file STDLIB_CORE.thx
# \info The standard library's small core: `Option` (OPT), tuples and
#       the integer helpers (MATH). A `$ with MOD` import makes the module's
#       public names (and types) usable unqualified; everything stays
#       reachable qualified (`OPT.is_some`, ...).

$ with OPT
$ with MATH

# ---- Option ----
$ o : Option @int = Option.Some.{ 41 }
$ n : Option @int = Option.None
$ ck_some   : @int = if is_some o => 0 else 1
$ ck_none   : @int = if is_none n => 0 else 1
$ ck_unwrap : @int = if (unwrap_or o 0) ?= 41 => 0 else 1
$ ck_default: @int = if (unwrap_or n 7) ?= 7 => 0 else 1
$ ck_map    : @int = if (unwrap_or (opt_map (\x = x + 1) o) 0) ?= 42 => 0 else 1
$ ck_then   : @int =
	let half = \x = if x % 2 ?= 0 => Option.Some.{ x / 2 } else Option.None in
	if (unwrap_or (opt_then half o) 99) ?= 99 => 0 else 1

# ---- tuples (the language's anonymous products) ----
$ p : {@int, @str} = {1, "one"}
$ ck_fst  : @int = if p.0 ?= 1 => 0 else 1
$ ck_snd  : @int = if p.1 ?= "one" => 0 else 1
$ ck_swap : @int = if {p.1, p.0}.1 ?= 1 => 0 else 1

# ---- MATH ----
$ ck_min   : @int = if (min 3 5) ?= 3 => 0 else 1
$ ck_max   : @int = if (max 3 5) ?= 5 => 0 else 1
$ ck_abs   : @int = if (abs (0 - 9)) ?= 9 => 0 else 1
$ ck_sign  : @int = if (sign (0 - 2)) + 1 ?= 0 => 0 else 1
$ ck_clamp : @int = if (clamp 0 10 42) ?= 10 => 0 else 1
$ ck_even  : @int = if even 4 => 0 else 1
$ ck_odd   : @int = if odd (0 - 3) => 0 else 1
$ ck_gcd   : @int = if (gcd 12 18) ?= 6 => 0 else 1
$ ck_pow   : @int = if (pow 2 10) ?= 1024 => 0 else 1
$ ck_cmp   : @int =
	if (cmp_int 1 2) ?< 0 => (if (cmp_int 5 5) ?= 0 => 0 else 1) else 1

# ---- MATH on Reals (libm through the C namespace; exact IEEE results) ----
$ ck_sqrt  : @int = if (sqrt 9.0) ?= 3.0 => 0 else 1
$ ck_floor : @int = if (floor 2.7) ?= 2.0 => 0 else 1
$ ck_ceil  : @int = if (ceil 2.1) ?= 3.0 => 0 else 1
$ ck_round : @int = if (round 2.5) ?= 3.0 => 0 else 1
$ ck_rpow  : @int = if (pow 2.0 10.0) ?= 1024.0 => 0 else 1
$ ck_fmod  : @int = if (fmod 7.5 2.0) ?= 1.5 => 0 else 1
$ ck_trig  : @int = if (sin 0.0) ?= 0.0 => (if (cos 0.0) ?= 1.0 => 0 else 1) else 1
$ ck_explog: @int = if (log (exp 1.0)) ?= 1.0 => 0 else 1
$ ck_rmin  : @int = if (min 1.5 2.5) ?= 1.5 => 0 else 1
$ ck_rabs  : @int = if (abs (0.0 - 4.5)) ?= 4.5 => 0 else 1
$ ck_rclamp: @int = if (clamp 0.0 1.0 7.25) ?= 1.0 => 0 else 1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @int = ck_some + ck_none + ck_unwrap + ck_default + ck_map + ck_then
	+ ck_fst + ck_snd + ck_swap
	+ ck_min + ck_max + ck_abs + ck_sign + ck_clamp + ck_even + ck_odd
	+ ck_gcd + ck_pow + ck_cmp
	+ ck_sqrt + ck_floor + ck_ceil + ck_round + ck_rpow + ck_fmod
	+ ck_trig + ck_explog + ck_rmin + ck_rabs + ck_rclamp
