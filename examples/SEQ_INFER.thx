@mod SEQ_INFER

# `[..]` infers its container from context: @list by default, @array when the
# type says so (see documentation/strings-and-arrays.md). Same syntax, no `@`.

# @array context -> a byte vector.
$ bytes : @array = [10, 20, 30]
$ ck_alen : Int = if (@array_len bytes) ?= 3 => 0 else 1
$ ck_a1   : Int = if (@array_get bytes 1) ?= 20 => 0 else 1

# @list context -> the blessed @list.
$ nums : @list Int = [1, 2, 3, 4]
$ sum : @list Int -> Int = \xs =
	is xs | [] => 0
	           | h :: t => h + sum t
	           else 0
$ ck_sum : Int = if (sum nums) ?= 10 => 0 else 1

# Empty literal in each context.
$ empt_a : @array = []
$ empt_l : @list Int = []
$ ck_ea : Int = if (@array_len empt_a) ?= 0 => 0 else 1
$ ck_el : Int = if (sum empt_l) ?= 0 => 0 else 1

# Unannotated defaults to @list.
$ deflist : @list Int = [7, 8]
$ ck_def : Int = if (sum deflist) ?= 15 => 0 else 1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : Int = ck_alen + ck_a1 + ck_sum + ck_ea + ck_el + ck_def
