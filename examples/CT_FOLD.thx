@mod CT_FOLD

# \file CT_FOLD.thx
# \info Aggregate value-folding at compile time. `$ x : T = @e X` runs X through
#       the interpreter at build time and splices the RESULT back as source.
#       Beyond scalars, an aggregate result renders as its type-directed literal:
#       a vector `[..]`, a tuple `{..}`, a struct `Name.{ .f = v }`, or a variant
#       `Ty.Tag.{ .. }` (bare `Ty.Tag` when nullary). So a table computed once at
#       build time is baked into the program instead of recomputed at run time.
#       The annotation on each binding pins the type the literal folds into.

$ with VEC

$ Color : @struct =
	r: @int,
	g: @int,
	b: @int,

$ Opt : @union t = None: {}, Some: {t},

# A compile-time generator: the first `n` squares, built by recursion.
$ squares_up_to : @int -> @vec @int = \n =
	if n ?= 0 => VEC.new {} else VEC.push (squares_up_to (n - 1)) ((n - 1) * (n - 1))

# Folded aggregates: each `@e` result is rendered back as its literal.
$ squares : @vec @int = @e (squares_up_to 6)          # [0, 1, 4, 9, 16, 25]
$ bounds  : {@int, @int} = @e ({0, 25})               # {0, 25}
$ grey    : Color = @e (Color.{ .r = 20, .g = 20, .b = 20 })
$ some7   : Opt @int = @e (Opt.Some.{ 3 + 4 })         # Opt.Some.{ 7 }
$ none    : Opt @int = @e Opt.None                     # Opt.None

$ opt_or : @int -> Opt @int -> @int = \d o =
	is o | Opt.Some.{x} => x else d

$ ck_vec : @int = if VEC.sum squares ?= 55 => 0 else 1
$ ck_tup : @int = if (bounds.0 + bounds.1) ?= 25 => 0 else 2
$ ck_str : @int = if (grey.r + grey.g + grey.b) ?= 60 => 0 else 4
$ ck_var : @int = if (opt_or 0 some7 + opt_or 9 none) ?= 16 => 0 else 8

$ test : @int = ck_vec + ck_tup + ck_str + ck_var
