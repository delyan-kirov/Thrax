$ @mod META_PATTERN

# \file META_PATTERN.ares
# \info Pattern-position `&`. `&X` in a pattern runs X at build time. A constant
#       (a number, a `@Bool`, a `@Str`) is inserted as a literal, so `&answer`
#       matches the value of the global `answer`, and exhaustiveness treats it
#       like a hand-written `42`. A bare name in a pattern always binds: only
#       the `&` turns it into a constant. X may also build an `@Code` holding a
#       PATTERN (a quotation, a string literal expected as `@Code`), whose
#       source replaces the `&X` before the final compile. The operand binds like a prefix operator, so it ends
#       before the `=>`, `|` or `::` after it. A spliced pattern binds the
#       names the site hands its generator as code, which the arm body uses as
#       if they were written there. A name the generator's own quotation spells
#       is hygienic: it binds only names the same quotation spells.

$ @import OPT

$ answer : @Int = 6 * 7

# The arm matches `42`, folded from `answer` while compiling.
$ is_answer : @Int -> @Bool = \ | &answer => @true | _ => @false

# Several computed arms, in a match on a scrutinee.
$ classify : @Int -> @Str = \n =>
    n |> \
        | &(2 * 3)      => "six"
        | &(answer + 1) => "forty-three"
        | _             => "other"

# A generated pattern that binds: the site names the binder, `"x"`, so the
# body sees `x` as if it were written.
$ some_of : @Code -> @Code = \v => "Option.Some.{?(v)}"
$ or_zero : Option @Int -> @Int = \ | &some_of "x" => x | _ => 0

# In a `let`: the pattern is a tuple the generator builds.
$ pair_of : @Code -> @Code -> @Code = \a b => "{?(a), ?(b)}"
$ sum_pair : @Int = let &pair_of "a" "b" = { 3, 4 } in a + b

$ ck1 : @Int = if is_answer 42 && !(is_answer 41) => 0 else 1
$ ck2 : @Int = if classify 6 == "six" && classify 43 == "forty-three" => 0 else 2
$ ck3 : @Int = if classify 7 == "other" => 0 else 4
$ ck4 : @Int = if or_zero (Option.Some.{ 5 }) == 5 && or_zero Option.None == 0 => 0 else 8
$ ck5 : @Int = if sum_pair == 7 => 0 else 16

$ test : @Int = ck1 + ck2 + ck3 + ck4 + ck5

$ &assert (test == 0) "META_PATTERN: a check failed"
