$ @mod CT_ASSERT

# \file CT_ASSERT.ares
# \info Compile-time assertions, in USER CODE (no `@assert` builtin needed).
#       `$ &X` runs X at build time and inserts the code it returns;
#       `@abort <msg>` fails the build with that message. `assert` is an ordinary
#       CORE function (`@Bool -> @Str -> <@Meta> @Code`, one line of Ares) that
#       returns empty code, so the directive inserts nothing, and a wrong result
#       below fails `ares check`/`build`/`run`.
#
#       `@abort` carries the `<@Meta>` effect, so a function that performs it
#       declares `<@Meta>` in its type. `&` discharges `<@Meta>`; outside a `&`
#       a meta op is a clean "effect `@Meta` not handled" error.

$ fib : @Int -> @Int = \n => if n < 2 => n else fib (n - 1) + fib (n - 2)

$ fact : @Int -> @Int = \n => if n < 2 => 1 else n * fact (n - 1)

# Checked at compile time: a wrong number here fails the build with the message.
$ &assert (fib 10 == 55) "fib 10 should be 55"
$ &assert (fact 5 == 120) "fact 5 should be 120"
$ &assert (fib 10 + fact 5 == 175) "fib 10 + fact 5 should be 175"

# Runtime side-check (the real test is the compile-time asserts above).
$ test : @Int = if fib 10 == 55 => 0 else 1

$ &assert (test == 0) "CT_ASSERT: a check failed"
