$ @mod CONDITIONALS

# \file conditionals.thx
# \info Branching with `if c => e else alt`, including else-if chains. A comma
#       chains further arms inside one `if`, so `if a => b, c => d else e` is the
#       same expression as `if a => b else if c => d else e`.

$ abs : @Int -> @Int = \n = if n > 0 => n else -n

$ sign : @Int -> @Int = \n = if n == 0 => 0 else if n > 0 => 1 else -1

# The same chain written with comma-separated arms; a trailing comma before
# `else` is allowed.
$ sign2 : @Int -> @Int = \n = if n == 0 => 0, n > 0 => 1, else -1

$ max : @Int -> @Int -> @Int = \a b = if a > b => a else b

$ min : @Int -> @Int -> @Int = \a b = if a < b => a else b

$ abs_neg = abs (-9)
$ abs_pos = abs 9
$ sign_neg = sign (-3)
$ sign_zero = sign 0
$ sign_pos = sign 3
$ sign2_agree = (sign2 (-3) - sign (-3)) + (sign2 0 - sign 0) + (sign2 3 - sign 3)
$ max_ex = max 3 7
$ min_ex = min 3 7

# Force-evaluate results for the combined test runner (pass = no fault).
$ test : @Int = abs_neg; abs_pos; sign_neg; sign_zero; sign_pos; max_ex; min_ex; sign2_agree

$ @e <| assert (test == 0) "CONDITIONALS: a check failed"
