@mod CONDITIONALS

# \file conditionals.thx
# \info Branching with `if c then e else alt`, including else-if chains.

$abs : @int -> @int = \n =
	if n ?> 0 => n
	else 0 - n

$sign : @int -> @int = \n =
	if n ?= 0 => 0
	else if n ?> 0 => 1
	else 0 - 1

$max : @int -> @int -> @int = \a b =
	if a ?> b => a
	else b

$min : @int -> @int -> @int = \a b =
	if a ?< b => a
	else b

$abs_neg   = abs (0 - 9)
$abs_pos   = abs 9
$sign_neg  = sign (0 - 3)
$sign_zero = sign 0
$sign_pos  = sign 3
$max_ex    = max 3 7
$min_ex    = min 3 7

# Force-evaluate results for the combined test runner (pass = no fault).
$ test : @int = abs_neg ; abs_pos ; sign_neg ; sign_zero ; sign_pos ; max_ex ; min_ex ; 0
