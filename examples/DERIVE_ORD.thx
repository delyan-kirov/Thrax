$ @mod DERIVE_ORD

# \file DERIVE_ORD.thx
# \info Deriving COMPARISON at compile time. `derive_ord "T"` reflects on a type
#       (like `derive_show`) and generates a structural three-way
#       `cmp_T : T -> T -> @Int` (-1 / 0 / 1), plus the `IOrd T` and `IEq T`
#       instances and the named `lt_T`/`le_T`/`gt_T`/`ge_T`/`eq_T` over it, so `<`
#       and `==` work on a custom struct or union. A struct compares
#       lexicographically by field; a union by variant order, then payload.

$ with DERIVE

$ Coord : @struct =
    x: @Int,
    y: @Int,

$ Geom : @union =
    Dot: {},
    Circle: { @Int },
    Rect: { @Int, @Int },

# Generate `cmp_T`, the `IOrd`/`IEq` instances, and the named comparisons.
$ @e <| DERIVE.derive_ord "Coord"
$ @e <| DERIVE.derive_ord "Geom"

# Struct: lexicographic by field.
$ ck_lt : @Int = if lt_Coord (Coord.{ .x = 1, .y = 2 }) (Coord.{ .x = 1, .y = 3 }) => 0 else 1
$ ck_gt : @Int = if gt_Coord (Coord.{ .x = 2, .y = 0 }) (Coord.{ .x = 1, .y = 9 }) => 0 else 2
$ ck_eq : @Int = if eq_Coord (Coord.{ .x = 1, .y = 2 }) (Coord.{ .x = 1, .y = 2 }) => 0 else 4
$ ck_le : @Int = if le_Coord (Coord.{ .x = 1, .y = 2 }) (Coord.{ .x = 1, .y = 2 }) => 0 else 8
$ ck_ge : @Int = if ge_Coord (Coord.{ .x = 1, .y = 3 }) (Coord.{ .x = 1, .y = 2 }) => 0 else 16

# Union: ordered by variant (Dot < Circle < Rect), then by payload.
$ ck_tag : @Int = if lt_Geom Geom.Dot (Geom.Circle.{ 0 }) => 0 else 32
$ ck_pay : @Int = if lt_Geom (Geom.Rect.{ 1, 2 }) (Geom.Rect.{ 1, 3 }) => 0 else 64
$ ck_cmp : @Int = if cmp_Geom (Geom.Circle.{ 5 }) (Geom.Circle.{ 5 }) == 0 => 0 else 128

# The derived operators, over the same interfaces the base types use: `<` on a
# `Coord` resolves to the derived instance, `<` on an `@Int` still to CORE's.
$ ck_op_lt : @Int = if Coord.{ .x = 1, .y = 2 } < Coord.{ .x = 1, .y = 3 } => 0 else 256
$ ck_op_ge : @Int = if Geom.Rect.{ 1, 3 } >= Geom.Rect.{ 1, 2 } => 0 else 512
$ ck_op_eq : @Int = if Coord.{ .x = 4, .y = 5 } == Coord.{ .x = 4, .y = 5 } => 0 else 1024
$ ck_mixed : @Int = if (2 < 3) && (Geom.Dot < Geom.Rect.{ 0, 0 }) => 0 else 2048

$ test : @Int =
    ck_lt + ck_gt + ck_eq + ck_le + ck_ge + ck_tag + ck_pay + ck_cmp + ck_op_lt + ck_op_ge + ck_op_eq + ck_mixed

$ @e <| assert (test == 0) "DERIVE_ORD: a check failed"
