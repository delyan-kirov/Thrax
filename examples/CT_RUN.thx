$ @mod CT_RUN

# \file CT_RUN.thx
# \info Build directives: `$ @e <| @link "m"` runs at build time and adds the
#       named library to the link line for the native backend and to the dlopen
#       set for the interpreter, so a project declares its libraries in Thrax.
#       `@link` / `@link_path` carry the `<@meta>` effect and return empty code,
#       so the directive inserts nothing. `@abort`, the checking twin, lives in
#       CT_ASSERT.thx.

# A build directive: link/preload libm (the suite already uses libm via MATH,
# so this is exercised end to end in both engines without adding a dependency).
$ @e <| @link "m"

$ test : @int = 0

$ @e <| assert (test == 0) "CT_RUN: a check failed"
