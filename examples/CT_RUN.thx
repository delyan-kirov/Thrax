@mod CT_RUN

# \file CT_RUN.thx
# \info Compile-time execution: `$ @e <expr>` forces the expression through
#       the interpreter at build time (Jai's #run). The value is discarded --
#       except a build directive `@link` / `@link_path`, which steers the
#       compilation: the named library joins the link line for the native
#       backend and the dlopen set for the interpreter, so a project declares
#       its libraries in Thrax. `@abort`, the checking twin, lives in
#       CT_ASSERT.thx.

$ triple : @int -> @int = \n = n * 3

# A plain expression, forced at build time, value discarded.
$ @e triple 14

# A build directive: link/preload libm (the suite already uses libm via MATH,
# so this is exercised end to end in both engines without adding a dependency).
$ @e (@link "m")

$ test : @int = 0
