$ @mod META_TYPE

# \file META_TYPE.thx
# \info Type-position `@e`. `Foo : @e X = ...` runs X at build time; X must build an
#       `@Code` denoting a TYPE (with `@parse_str`), whose source is spliced into
#       the annotation before the final compile. This completes `@e` across all
#       three positions: expression (`let a = @e X`), item (`$ @e X`), and now type
#       (`Foo : @e X`). The generator picks the type from compile-time data, so one
#       source can specialize a binding's type by a build-time choice. A type
#       splice works at every type position: declaration members (struct fields,
#       union payloads, alias bodies, effect operations), effect-row arguments,
#       `@use` fields, and the annotations inside a body (`let x : T`,
#       `\(x : T)`, `(e : T)`).

# A compile-time generator: choose a type by name.
$ number_type : @Str -> @Code = \which =>
    if which == "wide" => @parse_str "@Int64" else @parse_str "@Int"

# The element type of a vector, computed at build time.
$ elem_type : {} -> @Code = \_ => @parse_str "@Int"

# The annotation is filled in by running the generator: `n : @Int64`.
$ n : @e (number_type "wide") = 1000 + 24

# `@e` nests inside a larger type: `xs : @Vec @Int`.
$ xs : @Vec (@e (elem_type {})) = [3, 4, 5]

# --- declaration members ------------------------------------------------------
$ Point : @struct = x: @e (elem_type {}), y: @e (number_type "narrow")
$ Shape : @union = Dot: {}, Square: @e (elem_type {})
$ Count : @alias = @e (elem_type {})
$ Cell : @effect = read : {} -> @e (elem_type {})

$ pt : Point = { .x = 3, .y = 4 }
$ side : Shape -> Count = \ | Shape.Square.{ s } => s | Shape.Dot => 0

# --- annotations inside a body and effect-row arguments -------------------------
$ annotated : @Int =
    let a : @e (elem_type {}) = 5 in
    let sq = \(b : @e (elem_type {})) => b * b in
    sq (a : @e (elem_type {}))

$ State : @effect s = get : {} -> s
$ peek : {} -> <State (@e (elem_type {}))> @Int = \_ => State.get {}
$ peeked : @Int =
    do peek {}
    ctl k | State.get u => k 7 | v => v

$ ck_scalar : @Int = if n == 1024 => 0 else 1
$ ck_nested : @Int = if @vec_len xs == 3 => 0 else 2
$ ck_struct : @Int = if pt.x + 1 == pt.y => 0 else 4
$ ck_union : @Int = if side (Shape.Square.{ 6 }) == 6 => 0 else 8
$ ck_body : @Int = if annotated == 25 => 0 else 16
$ ck_row : @Int = if peeked == 7 => 0 else 32

$ test : @Int = ck_scalar + ck_nested + ck_struct + ck_union + ck_body + ck_row

$ @e <| assert (test == 0) "META_TYPE: a check failed"
