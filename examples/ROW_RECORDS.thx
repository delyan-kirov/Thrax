@mod ROW_RECORDS

# \file row_records.thx
# \info Row-polymorphic records. A record type may leave its tail open with a row
#       variable: `{ x: Int, y: Int | r }` is "any record with (at least) x and y
#       of type Int". A function over such a type accepts ANY record that has
#       those fields, nominal struct or anonymous. Anonymous records are written
#       `{ .field = value, ... }`; `{ .f = v | base }` updates a record (the rest
#       come from `base`), and `{ .f = v, with base }` stacks fields onto it.
#       Records are structural rows, like effect rows.

$ area : { x: Int, y: Int | r } -> Int = \p = p.x * p.y

$ Point : @struct = x: Int, y: Int,
$ Boxed : @struct = x: Int, y: Int, z: Int,

# An anonymous record value; its type is inferred as the structural row.
$ base = { .x = 3, .y = 4 }

# One open-row function, applied to two different nominal structs and to
# anonymous records (with an extra field the row variable absorbs).
$ ck_point : Int = if area Point.{ .x = 3, .y = 4 } ?= 12 => 0 else 1
$ ck_boxed : Int = if area Boxed.{ .x = 5, .y = 6, .z = 9 } ?= 30 => 0 else 2
$ ck_anon  : Int = if area { .x = 2, .y = 5, .tag = 7 } ?= 10 => 0 else 4

# Update: override x, keep y from base (`{ x = 10, y = 4 }`).
$ ck_update : Int = if area { .x = 10 | base } ?= 40 => 0 else 8

# Stack: add z on top of base (`{ z = 1, x = 3, y = 4 }`), area ignores z.
$ ck_stack : Int = if area { .z = 1, with base } ?= 12 => 0 else 16

$ test : Int = ck_point + ck_boxed + ck_anon + ck_update + ck_stack
