$ @mod REALS

# \file reals.thx
# \info 64-bit Real literals (decimal and scientific) and Real arithmetic. The
#       operators are the same as for @Int -- overload resolution picks the Real
#       implementation from the operand types.

$ pi : @Float64 = 3.14159
$ e : @Float64 = 2.71828
$ sci : @Float64 = 1.5e3
$ small : @Float64 = 2.5e-2
$ sum : @Float64 = 1.5 + 2.5
$ product : @Float64 = 2.0 * 3.5
$ diff : @Float64 = 10.0 - 0.5
$ quot : @Float64 = 7.0 / 2.0
$ negate : @Float64 = -4.2

# comparisons on Reals still yield an @Int (0/1)
$ lt : @Bool = 1.5 < 2.5
$ ge : @Bool = 3.0 >= 3.0
$ eq : @Bool = 0.1 == 0.1

# a Real-typed recursive function
$ pow : Real -> @Int -> Real = \base n = if n == 0 => 1.0 else base * (pow base (n - 1))

$ two_pow_10 : @Float64 = pow 2.0 10
$ half_cubed : @Float64 = pow 0.5 3

# Force-evaluate results for the combined test runner (pass = no fault).
$ test : @Int =
    pi; e; sci; small; sum; product; diff; quot; negate; lt; ge; eq; two_pow_10; half_cubed; 0

$ @e <| assert (test == 0) "REALS: a check failed"
