@mod STREAMS

# \file STREAMS.thx
# \info Unbounded structures from ordinary recursive types. A field whose type
#       leads back to the type declaring it holds its value lazily, so `Stream`
#       is a plain `@struct` (`head : t, tail : Stream t`): building a cell does
#       not build the rest, and scrutinising one forces exactly the cell looked
#       at. The forced value replaces the thunk, so a cell costs its work once.
#       The same rule applies to a recursive `@union`, which is how `List` can be
#       consumed a cons at a time.

# `Stream` and the ascending-integer generator `count_from` are canonical, defined
# in CORE (bare everywhere), so this file demonstrates observing and mapping one.

# The nth element, walking `tail` n times.
$ nth : @int -> Stream t -> t = \n s =
	if n == 0 => s.head else nth (n - 1) s.tail

# Map over a stream (still infinite, still lazy).
$ smap : (a -> b) -> Stream a -> Stream b = \f s =
	{ .head = f s.head, .tail = smap f s.tail }

$ dbl : @int -> @int = \x = x + x

$ ck_head : @int = if (count_from 10).head == 10 => 0 else 1
$ ck_nth  : @int = if nth 5 (count_from 10) == 15 => 0 else 2
$ ck_map  : @int = if nth 4 (smap dbl (count_from 1)) == 10 => 0 else 4

# The open range `[lo ...]` is sugar for `count_from lo`, an infinite stream.
$ ck_range : @int = if nth 3 [7 ...] == 10 => 0 else 8

$ test : @int = ck_head + ck_nth + ck_map + ck_range

$ @run (assert (test == 0) "STREAMS: a check failed")
