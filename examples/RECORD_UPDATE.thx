@mod RECORD_UPDATE

# \file record_update.thx
# \info Record update: `Type.{ .field = e | base }` builds a new struct of the
#       same type, taking the listed fields from the literal and every unlisted
#       field from `base`. The `| base` update must be the last entry. The type
#       may be written (`Person.{ | base }`) or left off (`.{ | base }`) when it
#       is inferable from context, exactly like any bare struct literal. `base`
#       may be any expression of that type, and a listed field's value may itself
#       read from `base`. Each `chk*` is 0 when correct and 1 otherwise.

$ Person : @struct =
	name: Str,
	age: Int,

$ base : Person = Person.{ .name = "Alice", .age = 30 }

# Override one field; the other is copied from `base`. The type is inferred from
# the annotation, so no `Person.` prefix is needed.
$ renamed : Person = .{ .name = "Bob" | base }
$ chk_renamed_name : Int = if renamed.name ?= "Bob" => 0 else 1
$ chk_renamed_age  : Int = if renamed.age ?= 30 => 0 else 1

# The explicit `Person.` prefix still works.
$ older : Person = Person.{ .age = 31 | base }
$ chk_older_name : Int = if older.name ?= "Alice" => 0 else 1
$ chk_older_age  : Int = if older.age ?= 31 => 0 else 1

# Update only, inferred type: every field comes from `base`.
$ clone : Person = .{ | base }
$ chk_clone_name : Int = if clone.name ?= "Alice" => 0 else 1
$ chk_clone_age  : Int = if clone.age ?= 30 => 0 else 1

# A listed field may read from the same `base` it updates.
$ bumped : Person = Person.{ .age = base.age + 1 | base }
$ chk_bumped_name : Int = if bumped.name ?= "Alice" => 0 else 1
$ chk_bumped_age  : Int = if bumped.age ?= 31 => 0 else 1

# Three fields: several unlisted fields fill from the source.
$ Vec3 : @struct =
	x: Int,
	y: Int,
	z: Int,

$ origin : Vec3 = Vec3.{ .x = 0, .y = 0, .z = 0 }
$ shifted : Vec3 = .{ .y = 5 | origin }
$ chk_v_x : Int = if shifted.x ?= 0 => 0 else 1
$ chk_v_y : Int = if shifted.y ?= 5 => 0 else 1
$ chk_v_z : Int = if shifted.z ?= 0 => 0 else 1

# The source may be an arbitrary expression, not just a variable.
$ mkv : Int -> Vec3 = \n = Vec3.{ .x = n, .y = n, .z = n }
$ fromcall : Vec3 = Vec3.{ .z = 9 | (mkv 2) }
$ chk_call_x : Int = if fromcall.x ?= 2 => 0 else 1
$ chk_call_z : Int = if fromcall.z ?= 9 => 0 else 1

$ test : Int =
	  chk_renamed_name + chk_renamed_age
	+ chk_older_name + chk_older_age
	+ chk_clone_name + chk_clone_age
	+ chk_bumped_name + chk_bumped_age
	+ chk_v_x + chk_v_y + chk_v_z
	+ chk_call_x + chk_call_z
