$ @mod ARITHMETIC

# \file arithmetic.thx
# \info Integer arithmetic: operator precedence, grouping, division, modulo,
#       and unary negation.

$ sum : @Float64 = -1.0 + 2.0 + 3.0 + 4.2
$ product : @Int = 2 * 3 * 4
$ precedence : @Int = 1 + 2 * 3 - 4
$ grouped : @Int = (1 + 2) * (3 - 4) + 5
$ quotient : @Int = 100 / 7
$ remainder : @Float64 = 100.123 % 7.0
$ negate : @Int = -42
$ double_neg : @Int = - (-7)
$ chained : @Int = 1 - 2 - 3 - 4
$ big : @Int = (3 * (244 - 57 + 4) - (74 - 777)) / 5 + (4 + 27) * (3 - 7)
$ exp : @Int = 2 ^ 3

# Force-evaluate results for the combined test runner (pass = no fault).
$ test : @Int =
    sum; product; precedence; grouped; quotient; remainder; negate; double_neg; chained; big; 0

$ @e <| assert (test == 0) "ARITHMETIC: a check failed"
