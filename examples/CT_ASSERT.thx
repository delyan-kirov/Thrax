@mod CT_ASSERT

# \file CT_ASSERT.thx
# \info Compile-time assertions, in USER CODE (no `@assert` builtin needed). A
#       `$ @e <expr>` forces the expression through the interpreter at build
#       time; `@abort <msg>` fails the build with that message. So `assert` is an
#       ordinary function, and a wrong result below fails `thrax build`/`run`.

# The reusable assert: at compile time, a false condition aborts the build.
# `@abort` carries the `<@meta>` effect, so a function that performs it declares
# `<@meta>` in its type; the `$ @e` calls below install the handler that discharges
# it. (A use outside `@e` is a clean "effect `@meta` not handled" error.)
$ assert : @bool -> @str -> <@meta> {} = \ok msg = if ok => {} else @abort msg

$ fib : @int -> @int = \n =
	if n ?< 2 => n else fib (n - 1) + fib (n - 2)

$ fact : @int -> @int = \n =
	if n ?< 2 => 1 else n * fact (n - 1)

# Checked at compile time: a wrong number here fails the build with the message.
$ @e (assert (fib 10 ?= 55) "fib 10 should be 55")
$ @e (assert (fact 5 ?= 120) "fact 5 should be 120")
$ @e (assert (fib 10 + fact 5 ?= 175) "fib 10 + fact 5 should be 175")

# Runtime side-check (the real test is the compile-time asserts above).
$ test : @int = if fib 10 ?= 55 => 0 else 1
