$ @mod META_TYPE

# \file META_TYPE.ares
# \info Type-position `&`. `Foo : &X = ...` runs X at build time; X must build an
#       `@Code` denoting a TYPE, whose source is spliced into the annotation
#       before the final compile, as `&` does in expression (`let a = &X`) and
#       item (`$ &X`) position. The generator picks the type from compile-time
#       data, so one source can specialize a binding's type by a build-time
#       choice. A type splice works at every type position: declaration members
#       (struct fields, union payloads, alias bodies, effect operations),
#       effect-row entries and their arguments, `@use` fields, and the
#       annotations inside a body (`let x : T`, `\(x : T)`, `(e : T)`). The code
#       is a quotation, a string literal expected as `@Code`; the splice site
#       checks it parses as a type (or as row entries in `<&X>`).

# A compile-time generator: choose a type by name.
$ number_type : @Str -> @Code = \which => if which == "wide" => "@Int64" else "@Int"

# The element type of a vector, computed at build time.
$ elem_type : {} -> @Code = \_ => "@Int"

# The annotation is filled in by running the generator: `n : @Int64`.
$ n : &number_type "wide" = 1000 + 24

# `&` nests inside a larger type: `xs : @Vec @Int`.
$ xs : @Vec (&elem_type {}) = [3, 4, 5]

# --- declaration members ------------------------------------------------------
$ Point : @struct = x: &elem_type {}, y: &number_type "narrow"
$ Shape : @union = Dot: {}, Square: &elem_type {}
$ Count : @alias = &elem_type {}
$ Cell : @effect = read : {} -> &elem_type {}

$ pt : Point = { .x = 3, .y = 4 }
$ side : Shape -> Count = \ | Shape.Square.{ s } => s | Shape.Dot => 0

# --- annotations inside a body and effect-row arguments -------------------------
$ annotated : @Int =
    let a : &elem_type {} = 5 in let sq = \(b : &elem_type {}) => b * b in sq (a : &elem_type {})

$ State : @effect s = get : {} -> s
$ peek : {} -> <State (&elem_type {})> @Int = \_ => State.get {}
$ peeked : @Int =
    do peek {}
    ctl k | State.get u => k 7 | v => v

# A whole row entry, or several, can come from a generator too: `<&X>`.
$ Log : @effect = log : @Int -> {}
$ row : {} -> @Code = \_ => "Log, State @Int"
$ logged : {} -> <&row {}> @Int = \_ => Log.log 1; State.get {}
$ logged_value : @Int =
    do logged {}
    ctl k
    | State.get u => k 9
    | Log.log _   => k {}
    | v           => v

$ ck_scalar : @Int = if n == 1024 => 0 else 1
$ ck_nested : @Int = if @vec_len xs == 3 => 0 else 2
$ ck_struct : @Int = if pt.x + 1 == pt.y => 0 else 4
$ ck_union : @Int = if side (Shape.Square.{ 6 }) == 6 => 0 else 8
$ ck_body : @Int = if annotated == 25 => 0 else 16
$ ck_row : @Int = if peeked == 7 && logged_value == 9 => 0 else 32

$ test : @Int = ck_scalar + ck_nested + ck_struct + ck_union + ck_body + ck_row

$ &assert (test == 0) "META_TYPE: a check failed"
