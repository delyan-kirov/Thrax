@mod FIB

# \file fib.thx
# \info The Fibonacci sequence by naive double recursion.

$fib : @int -> @int = \n =
	if n ?= 0 => 0
	else if n ?= 1 => 1
	else (fib (n - 1)) + (fib (n - 2))

$ foo =
	let bar = \x y = x + y
	 in bar 2 3

$fib0  = fib 0
$fib1  = fib 1
$fib5  = fib 5
$fib10 = fib 10
$fib15 = fib 15

# A generic list and its length, by a tail-recursive accumulator. `helper` is an
# annotated, recursive `let`; the match arms are bare variant patterns (`.Nil`,
# `.Cons`) whose union is inferred from the constructors. `@list` is the prelude
# type (its `[..]`/`::` sugar is hardwired to that name).
$ len: @list t -> @int =
	let helper: @list t -> @int -> @int = \l n =
		is l
			| [] => n
			| _ :: xs => helper xs (n + 1)
			else n
	 in \l = helper l 0

$ to: @int -> @int -> @list @int = \a b =
	let helper: @int -> @int -> @list @int -> @list @int =
		\a b xs =
			if a ?< b => helper (a+1) b (a :: xs)
			else xs
	 in helper a b []

$ sample : @list @int = to 0 3
$ len3 : @int = is len sample | 3 => 0 else 1

$ Point: @struct =
	x: @int,
	y: @int,

$ add: @int -> @int -> @int = \a b = a + b
$ add: Real -> Real -> Real = \a b = a + b
$ add: Point -> Point -> Point = \p1 p2 =
	.{.x = p1.x + p2.x, .y = p1.y + p2.y}

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @int =
	len3
	+ (if fib5 ?= 5 => 0 else 1)
	+ (if fib10 ?= 55 => 0 else 1)
	+ (if fib15 ?= 610 => 0 else 1)
