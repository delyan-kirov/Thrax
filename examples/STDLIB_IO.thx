$ @mod STDLIB_IO

# \file STDLIB_IO.thx
# \info The standard library's IO module: file round-trips and the
#       environment. Console printing is exercised lightly (the combined
#       runner owns the suite's output); the file tests write in the
#       working directory, which every platform has (unlike /tmp), and clean
#       up after themselves.

$ with IO
$ with OPT
$ with STR
$ with VEC

$ path : @Str = "thrax_stdlib_io_test.txt"

# Write, append, read back, remove -- each step feeding the next. An effect row
# lives on an arrow, so a check that performs `@IO` takes `{}` and declares it;
# only `ck_fmt` (pure string formatting) stays a plain value.
$ ck_roundtrip : {} -> <@IO> @Int =
    let w = write_file path "line one\nline two\n" in
    if !w => 1
    else
        let a = append_file path "line three\n" in
        if !a => 1
        else
            let body = unwrap_or (read_file path) "<unreadable>" in
            let rm = remove_file path in
            if body == "line one\nline two\nline three\n" => (if rm => 0 else 1) else 1

# A second remove fails: the file is gone.
$ ck_gone : {} -> <@IO> @Int = if remove_file path => 1 else 0

# An unopenable path is None, not a fault.
$ ck_missing : {} -> <@IO> @Int =
    if is_none (read_file "/tmp/thrax_stdlib/definitely/not/here") => 0 else 1

# A directory listing: `examples/` holds this very file, the names come back
# sorted, and `.`/`..` are not among them. Run from the repo root, like the rest
# of the corpus.
$ ck_dir : {} -> <@IO> @Int =
    let names = read_dir "examples" in
    if !(VEC.contains STR.eq "STDLIB_IO.thx" names) => 1
    else if VEC.contains STR.eq "." names => 1
    else if VEC.is_empty names => 1
    else sorted_from names 1

# An unreadable directory is empty, not a fault.
$ ck_dir_missing : {} -> <@IO> @Int =
    if VEC.is_empty (read_dir "/tmp/thrax_stdlib/definitely/not/here") => 0 else 1

# The environment: PATH is set on every platform (HOME is POSIX-only, absent on
# Windows), and unset variables come back "".
$ ck_env : {} -> <@IO> @Int = if (env "PATH") == "" => 1 else 0
$ ck_env_none : {} -> <@IO> @Int = if (env "THRAX_SURELY_UNSET_VAR_42") == "" => 0 else 1

# Number formatting composes with printing (evaluated for effect-freeness
# here; the string is checked, the console write is the runner's).
$ ck_fmt : @Int = if (from_int 42) == "42" => 0 else 1

# Aggregate check for the combined test runner: 0 = all pass. It performs `@IO`,
# so it too is a unit-taking function; the runner calls it as `test {}`.
$ test : {} -> <@IO> @Int =
    ck_roundtrip {} + ck_gone {} + ck_missing {} + ck_dir {} + ck_dir_missing {} + ck_env {} + ck_env_none {} + ck_fmt

# Every adjacent pair in order, from index `i`; 0 when the whole vector is.
$ sorted_from : @Vec @Str -> @Int -> @Int = \names i =
    if i >= VEC.len names => 0
    else if STR.cmp_str (VEC.get_or names (i - 1) "") (VEC.get_or names i "") > 0 => 1
    else sorted_from names (i + 1)

# These checks touch the filesystem, so they run at run time rather than under a
# `$ @e` compile-time assert like the rest of the corpus: this module is a
# program, and `$ @main` is what makes it one.
$ @main : @Vec @Str -> <@IO> @Int = \args = test {}
