@mod STDLIB_VEC

# \file STDLIB_VEC.thx
# \info The standard library's growable vector, `@vec `T`

$ with VEC
$ with OPT

$ v : @vec @int = push (push (push (new {}) 10) 20) 30

$ ck_len   : @int = if (len v) ?= 3 => 0 else 1
$ ck_get   : @int = if (get_or v 1 0) ?= 20 => 0 else 1
$ ck_oob   : @int = if is_some (get v 3) => 1 else 0
$ ck_neg   : @int = if is_some (get v (0 - 1)) => 1 else 0
$ ck_last  : @int = if (unwrap_or (last v) 0) ?= 30 => 0 else 1
$ ck_empty : @int = if is_empty (new {}) => 0 else 1
$ ck_nonem : @int = if is_empty v => 1 else 0

# Mutators are functional: the original is undisturbed.
$ ck_set    : @int = if (get_or (set v 0 99) 0 0) ?= 99 => 0 else 1
$ ck_shared : @int = if (get_or v 0 0) ?= 10 => 0 else 1
$ ck_setoob : @int = if (len (set v 9 99)) ?= 3 => 0 else 1
$ ck_push   : @int = if (len (push v 40)) ?= 4 => 0 else 1
$ ck_pushed : @int = if (len v) ?= 3 => 0 else 1

# fill makes n copies; whole-vector ops round-trip through @vec.
$ ck_fill  : @int = if (fold (\a x = a + x) 0 (fill 4 7)) ?= 28 => 0 else 1
$ ck_froml : @int = if (len (from_list (to_list [1, 2, 3, 4]))) ?= 4 => 0 else 1
$ ck_tol   : @int = if (sum (from_list (to_list [1, 2, 3, 4]))) ?= 10 => 0 else 1
$ ck_map   : @int =
	if (sum (map (\x = x * 2) [1, 2, 3])) ?= 12
	=> 0 else 1
$ ck_fold  : @int = if (fold (\a x = a * 10 + x) 0 v) ?= 1230 => 0 else 1

# @vec is generic: elements can be any type, tuples included.
$ pts : @vec {@int, @int} = push (push (new {}) {1, 2}) {3, 4}
$ ck_tup : @int =
	is get pts 1 | Option.Some.{p} =>
		(if (p.0 + p.1) ?= 7 => 0 else 1)
	else 1

# A larger build loop: the native backend reuses the unique spine in place.
$ ck_big : @int =
	let big = VEC.foldl (\a x = push a x) (new {}) (range 0 499) in
	if (len big) ?= 500 =>
		(if (fold (\a x = a + x) 0 big) ?= 124750 => 0 else 1)
	else 1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @int = ck_len + ck_get + ck_oob + ck_neg + ck_last + ck_empty
	+ ck_nonem + ck_set + ck_shared + ck_setoob + ck_push + ck_pushed
	+ ck_fill + ck_froml + ck_tol + ck_map + ck_fold + ck_tup + ck_big
