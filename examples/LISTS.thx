$ @mod LISTS

# \file lists.thx
# \info The `[]` surface, on the default sequence and on a type that opts in.
#       `[a, b, c]` builds a `@Vec`, `h :: t` conses onto one, and `[]` is the
#       empty one. Patterns mirror the sugar: `is []` / `is h :: t` destructure
#       a sequence one cell at a time, and a fixed-arity `[a, b]` matches a
#       sequence of exactly that length. The second half runs the same surface
#       on CORE's cons `List`, which is not a compiler type: it gets all of it
#       from three instances (`@ISeqLit`, `ICons`, `@ISeqView`), the same three any
#       type of your
#       own would write.

$ sum : @Vec @Int -> @Int = \xs = is xs | [] => 0 | h :: t => h + sum t

$ length : @Vec @Int -> @Int = \xs = is xs | [] => 0 | _ :: t => 1 + length t

$ map_inc : @Vec @Int -> @Vec @Int = \xs = is xs | [] => [] | h :: t => (h + 1) :: map_inc t

# Fixed-arity list patterns match a list of exactly that many elements, and
# nest freely -- `[a, b]` is `Cons(a, Cons(b, Nil))`, so it binds two cells and
# checks the third is `Nil`. Two arms may share the `Cons` head (`[a]` and
# `[a, b]`); a failed inner match falls through to the next arm.
$ size_class : @Vec @Int -> @Int = \xs =
    is xs
    | [] => 0
    | [a] => 1
    | [a, b] => 2
    | _ => 9

# An open list pattern `[a, ..rest]` binds leading cells and a `rest` tail
# (the remaining list), so it matches AT LEAST that many elements -- `[a, ..t]`
# is exactly `a :: t`, and `[a, b, ..t]` is `a :: b :: t`. `[..all]` binds the
# whole list.
$ second : @Vec @Int -> @Int = \xs = is xs | [_, x, ..rest] => x | _ => 0 - 1

$ drop2 : @Vec @Int -> @Vec @Int = \xs = is xs | [_, _, ..rest] => rest | _ => []

$ ck_second : @Int = if (second xs) == 2 => 0 else 1
$ ck_second_short : @Int = if (second [9]) == 0 - 1 => 0 else 1
$ ck_drop2 : @Int = if (sum (drop2 xs)) == 12 => 0 else 1
$ ck_head_tail : @Int = is xs | [h, ..t] => if (h + sum t) == 15 => 0 else 1 | _ => 1

# `[1, 2, 3]` and `1 :: 2 :: 3 :: []` are the same list.
$ xs : @Vec @Int = [1, 2, 3, 4, 5]
$ ys : @Vec @Int = 1 :: 2 :: 3 :: 4 :: 5 :: []

$ ck_sum : @Int = if (sum xs) == 15 => 0 else 1
$ ck_len : @Int = if (length xs) == 5 => 0 else 1
$ ck_cons : @Int = if (sum ys) == 15 => 0 else 1
$ ck_map : @Int = if (sum (map_inc xs)) == 20 => 0 else 1
$ ck_empty : @Int = if (sum []) == 0 => 0 else 1
$ ck_sc0 : @Int = if (size_class []) == 0 => 0 else 1
$ ck_sc1 : @Int = if (size_class [7]) == 1 => 0 else 1
$ ck_sc2 : @Int = if (size_class [7, 8]) == 2 => 0 else 1
$ ck_scN : @Int = if (size_class xs) == 9 => 0 else 1

# The cons `List` rides the same surface, from user space. Nothing below knows
# it is a `@union` rather than the built-in sequence.
$ ls : List @Int = [1, 2, 3, 4, 5]
$ ls2 : List @Int = 0 :: ls

$ lsum : List @Int -> @Int = \l = is l | [] => 0 | h :: t => h + lsum t

$ lsecond : List @Int -> @Int = \l = is l | [_, x, ..rest] => x | _ => 0 - 1

$ lsize_class : List @Int -> @Int = \l =
    is l
    | [] => 0
    | [a] => 1
    | [a, b] => 2
    | _ => 9

$ ck_lsum : @Int = if (lsum ls) == 15 => 0 else 1
$ ck_lcons : @Int = if (lsum ls2) == 15 => 0 else 1
$ ck_lsecond : @Int = if (lsecond ls) == 2 => 0 else 1
$ ck_lsc0 : @Int = if (lsize_class []) == 0 => 0 else 1
$ ck_lsc2 : @Int = if (lsize_class [7, 8]) == 2 => 0 else 1
$ ck_lscN : @Int = if (lsize_class ls) == 9 => 0 else 1

# `for` walks a List for effects. `Acc.add` collects what the body saw, so each
# check below reads off exactly which elements the loop reached.
$ Acc : @effect = add : @Int -> {},
$ collect : ({} -> <Acc | e> {}) -> <e> @Int = \body =
    do body {}; 0
    ctl k | Acc.add n => n + k {} | r => r

$ ck_for : @Int = if collect (\u = for ls (\x = Acc.add x)) == 15 => 0 else 1

# `break` stops the walk, `continue` skips one element.
$ ck_for_break : @Int =
    if collect (\u = for ls (\x = if x > 3 => break {} else Acc.add x)) == 6 => 0 else 1
$ ck_for_continue : @Int =
    if collect (\u = for ls (\x = if x % 2 == 1 => continue {} else Acc.add x)) == 6 => 0 else 1

# The tail slot of a `List` is lazy, so an unbounded one is fine as long as the
# body stops: `for` only ever builds the cells it reaches.
$ from : @Int -> List @Int = \n = List.Cons.{ n, from (n + 1) }
$ ck_for_unbounded : @Int =
    if collect (\u = for (from 1) (\x = if x > 5 => break {} else Acc.add x)) == 15 => 0 else 1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @Int =
    ck_second + ck_second_short + ck_drop2 + ck_head_tail + ck_sum + ck_len + ck_cons + ck_map + ck_empty + ck_sc0 + ck_sc1 + ck_sc2 + ck_scN + ck_lsum + ck_lcons + ck_lsecond + ck_lsc0 + ck_lsc2 + ck_lscN + ck_for + ck_for_break + ck_for_continue + ck_for_unbounded

$ @e <| assert (test == 0) "LISTS: a check failed"
