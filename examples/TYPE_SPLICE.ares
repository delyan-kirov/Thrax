$ @mod TYPE_SPLICE

# \file TYPE_SPLICE.ares
# \info Copying members between declarations with an `@e` entry. A `@struct` or
#       `@union` entry `@e X` runs `X` at build time, and the fields
#       (`@parse_fields`) or variants (`@parse_variants`) it builds take the
#       entry's place. DERIVE's `fields_of "Point"` and `variants_of "Base"`
#       build them from a declared type, so a type can repeat another's members
#       ahead of (or among) its own. It is a copy, no relationship: `Point3` is
#       not a `Point`. A copied type may itself be generated, and a generic one
#       is applied to the new type's own parameters (`fields_of "Pair b"`), and
#       an importer may use a generated type before its module has expanded it.

$ @import DERIVE
$ @import VEC
$ @import TYPE_SPLICE_LIB

$ Point : @struct = x: @Int, y: @Int
$ Point3 : @struct = @e <| DERIVE.fields_of "Point", z: @Int     # x, y, then z
$ Located : @struct = @e <| DERIVE.fields_of "Point3", tag: @Int # x, y, z, tag

$ Base : @union = Red: {}, Green: {}
$ Color : @union = @e <| DERIVE.variants_of "Base", Blue: {} # Red, Green, then Blue

# A generic struct, copied over the new type's own parameter.
$ Pair : @struct a = fst: a, snd: a
$ Labeled : @struct b = label: @Str, @e <| DERIVE.fields_of "Pair b"

# Any generator can build the entries: here, one field per name.
$ counters : @Vec @Str -> @Code = \names =>
    @parse_fields <| DERIVE.join ", " <| VEC.map (\n => n ++ ": @Int") names
$ Stats : @struct = @e <| counters ["hits", "misses"]

$ rank : Color -> @Int = \c =>
    c |> \
        | Color.Red   => 1
        | Color.Green => 2
        | Color.Blue  => 3

$ sum4 : Located -> @Int = \p => p.x + p.y + p.z + p.tag

$ ck_struct : @Int = if sum4 (Located.{ .x = 1, .y = 2, .z = 3, .tag = 4 }) == 10 => 0 else 1

$ ck_union : @Int = if (rank Color.Red + rank Color.Blue) == 4 => 0 else 2

$ pair : Labeled @Int = Labeled.{ .label = "p", .fst = 3, .snd = 4 }
$ ck_generic : @Int = if pair.fst + pair.snd == 7 => 0 else 4

$ stats : Stats = Stats.{ .hits = 5, .misses = 2 }
$ ck_gen : @Int = if stats.hits - stats.misses == 3 => 0 else 8

# `Box` is generated in TYPE_SPLICE_LIB.
$ box : Box = Box.{ .w = 2, .h = 3, .depth = 4 }
$ ck_import : @Int = if box.w * box.h * box.depth == 24 => 0 else 16

$ test : @Int = ck_struct + ck_union + ck_generic + ck_gen + ck_import

$ @e <| assert (test == 0) "TYPE_SPLICE: a check failed"
