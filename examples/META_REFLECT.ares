$ @mod META_REFLECT

# \file META_REFLECT.ares
# \info Compile-time reflection and diagnostics, the `<@Meta>` operations a
#       generator asks the compiler with. `@lookup name` is what is declared
#       under a name, as a CORE `Decl` to match: a struct or union with its
#       shape, a global value with its type, or `Missing`. `@here {}` is where
#       the running `@e` is. `@check code` type-checks a fragment as if written
#       at that `@e` and gives its type. `@fail` and `@warn` report a `Diag`
#       (a message with `note:` and `help:` lines) at the `@e`: `@fail` fails
#       the build, `@warn` lets it go on.

$ with STR

$ Rgb : @struct = r: @Int, g: @Int, b: @Int
$ Shape : @union = Dot: {}, Square: @Int, Rect: { @Int, @Int }
$ area : Shape -> @Int = \
    | Shape.Dot           => 0
    | Shape.Square.{ s }  => s * s
    | Shape.Rect.{ w, h } => w * h

# A one-line description of whatever a name is.
$ describe : @Str -> <@Meta> @Str = \name =>
    @lookup name |> \
        | Decl.Struct.{ _, fields } => "struct of " ++ STR.join ", " fields
        | Decl.Union.{ _, vs }      => "union of " ++ to_string (@vec_len vs)
        | Decl.Value.{ ty }         => ty
        | Decl.Missing              => "nothing"

# Bake the descriptions into the program as string literals.
$ quote : @Str -> @Code = \s => @parse_str <| "\"" ++ s ++ "\""
$ rgb_text : @Str = @e <| quote <| describe "Rgb"
$ shape_text : @Str = @e <| quote <| describe "Shape"
$ area_text : @Str = @e <| quote <| describe "area"
$ nothing_text : @Str = @e <| quote <| describe "Nobody"

# A generator that refuses a type it cannot handle, with a note and a help.
$ needs_struct : @Str -> <@Meta> @Code = \name =>
    @lookup name |> \
        | Decl.Struct.{ _, _ } => @parse_items ""
        | _                    => @fail {
            .message = "`" ++ name ++ "` is not a struct",
            .notes = ["this generator reads a struct's fields"],
            .helps = ["pass the name of a `@struct`"],
        }
$ @e <| needs_struct "Rgb"

# Where this `@e` is, and what a fragment's type would be here.
$ here_line : @Int = @e <| @parse_str <| to_string (@here {}).line
$ area_type : @Str = @e <| quote <| @check (@parse_str "area (Shape.Square.{ 3 })")

$ ck1 : @Int = if rgb_text == "struct of r, g, b" => 0 else 1
$ ck2 : @Int = if shape_text == "union of 3" => 0 else 2
$ ck3 : @Int = if area_text == "Shape -> @Int" => 0 else 4
$ ck4 : @Int = if nothing_text == "nothing" => 0 else 8
$ ck5 : @Int = if here_line == 49 => 0 else 16
$ ck6 : @Int = if area_type == "@Int" => 0 else 32

$ test : @Int = ck1 + ck2 + ck3 + ck4 + ck5 + ck6

$ @e <| assert (test == 0) "META_REFLECT: a check failed"
