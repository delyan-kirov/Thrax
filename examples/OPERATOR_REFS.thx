$ @mod OPERATOR_REFS

# \file OPERATOR_REFS.thx
# \info An operator in parentheses is a plain function value: `(+) 1 1` is
#       `1 + 1`. It refers to the same binding `$ (+) : ... = ...` defines, so it
#       curries, passes as an argument, and dispatches across the overload set
#       like any other function reference.

$ with VEC

$ apply2 : (@Int -> @Int -> @Int) -> @Int -> @Int -> @Int = \f a b = f a b

$ added : @Int = (+) 1 1
$ diff : @Int = (-) 10 4
$ times : @Int = (*) 6 7
$ quotient : @Int = (/) 84 2
$ power : @Int = (^) 2 5
$ less : @Bool = (<) 1 2
$ negated : @Bool = (!) @false

# Partial application: an operator reference curries like any other function.
$ add_one : @Int -> @Int = (+) 1
$ curried : @Int = add_one 41

# As a value and as an argument. Both sites are bare references with no argument
# types of their own, so the expected type picks the overload.
$ plus : @Int -> @Int -> @Int = (+)
$ bound : @Int = plus 2 3
$ passed : @Int = apply2 (+) 20 22
$ summed : @Int = foldl (+) 0 [1, 2, 3]

# A type of your own joins `+` by implementing its interface: `+` on a `Money` goes
# through this instance, `+` on an `@Int` through CORE's.
$ Money : @struct = cents: @Int

$ impl_IAdd_for_Money : IAdd Money = .{ .add = \a b = Money.{ .cents = a.cents + b.cents } }

$ pooled : Money = (+) Money.{ .cents = 150 } Money.{ .cents = 900 }

# An operator the parser rewrites rather than calls (`&&`, `||`, `;`, the pipes,
# `::`) has no binding of its own, so its reference is the function `\l r = l op r`.
# Referenced this way, `&&` evaluates both sides: short-circuiting is a property
# of the infix form, not of the function.
$ both : @Bool = (&&) @true @true
$ either : @Bool = (||) @false @true
$ piped : @Int = (|>) 3 add_one
$ consed : @Vec @Int = (::) 1 [2, 3]

# Grouping is unaffected: parens hold an operator reference only when that is
# all they hold.
$ grouped : @Int = (1 + 2) * 3
$ negative : @Int = (-1) + 2

$ test : @Int =
    if added == 2
        && diff == 6
        && times == 42
        && quotient == 42
        && power == 32
        && less
        && negated
        && curried == 42
        && bound == 5
        && passed == 42
        && summed == 6
        && pooled.cents == 1050
        && both
        && either
        && piped == 4
        && @vec_len consed == 3
        && grouped == 9
        && negative == 1 =>
        0
    else
        1

$ @e <| assert (test == 0) "OPERATOR_REFS: a check failed"
