@mod RANGES
$ with VEC
$ with LA

# \file ranges.thx
# \info Inclusive range patterns in `is` arms: `lo ... hi` matches when
#       `lo <= x <= hi`. Both bounds are numeric literals and both ends are
#       inclusive (Jai-style: there is only the inclusive form). A range is
#       refutable and binds nothing, so a match over ranges needs an `else`. The
#       scrutinee variable stays in scope in the arm if you need the value.
#       The EXPRESSION form `[lo ... hi]` (below) is the same `...`, materialized.

$ grade : @int -> @str = \n =
	is n
		| 90 ... 100 => "A"
		| 80 ...  89 => "B"
		| 70 ...  79 => "C"
		| 60 ...  69 => "D"
	else "F"

# An OPEN range pattern `lo ...` omits the upper bound: it matches when `lo <= x`.
$ sign : @int -> @str = \n = is n | 0 ... => "nonneg" else "neg"
$ ck_open_pat : @int = if sign 3 ?= "nonneg" => 0 else 1024
$ ck_open_neg : @int = if sign (0 - 3) ?= "neg" => 0 else 2048

# Inclusive at both ends: 60 is a D, 100 is an A.
$ ck_a  : @int = if grade 95  ?= "A" => 0 else 1
$ ck_a2 : @int = if grade 100 ?= "A" => 0 else 2
$ ck_c  : @int = if grade 70  ?= "C" => 0 else 4
$ ck_d  : @int = if grade 60  ?= "D" => 0 else 8
$ ck_f  : @int = if grade 42  ?= "F" => 0 else 16

# Ranges work on Real too; both bounds must share the scrutinee's type.
$ band : Real -> @int = \x =
	is x | 0.0 ... 0.5 => 1 | 0.5 ... 1.0 => 2 else 0
$ ck_r : @int = if band 0.25 ?= 1 => 0 else 32

# EXPRESSION form: `[lo ... hi]` is a TYPE-DIRECTED inclusive-range literal (the
# same `...`, materialized). By default it is a `@vec @int` (a runtime-length
# sequence). Empty when lo > hi.
$ ns : @vec @int = [1 ... 4]                         # [1, 2, 3, 4]
$ ck_build : @int = if sum ns ?= 10 => 0 else 64
$ ck_len   : @int = if length ns ?= 4 => 0 else 128
$ ck_empty : @int = if length [5 ... 2] ?= 0 => 0 else 256

# Against a sized tensor `[n]T` it builds the tensor instead: the LITERAL bounds fix
# `n = hi - lo + 1` at compile time. A non-literal bound to a sized tensor is a
# compile-time error (its length would not be statically known).
$ tv : [4]@int = [1 ... 4]                           # the tensor [1, 2, 3, 4]
$ ck_tens : @int = if tv.[0] + tv.[3] ?= 5 => 0 else 512

# An OPEN range `[lo ...]` has no upper bound, so it is infinite: it builds a
# `Stream @int` (the only shape that holds an unbounded sequence). Observe it lazily.
$ evens : Stream @int = [3 ...]
$ ck_stream : @int = if evens.head + evens.tail.head ?= 7 => 0 else 4096

$ test : @int =
	ck_a + ck_a2 + ck_c + ck_d + ck_f + ck_r + ck_build + ck_len + ck_empty + ck_tens
	+ ck_open_pat + ck_open_neg + ck_stream
