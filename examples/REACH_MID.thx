$ @mod REACH_MID

# \file REACH_MID.thx
# \info The middle of a three-module chain (see `REACH`): a struct whose field
#       holds a type from `REACH_LIB`, which `REACH` does not import.

$ with REACH_LIB

$ Bag : @struct = items : @Vec Item, best : Item

$ bag : {} -> Bag = \u =
    Bag.{
        .items = @vec_new {} |> \v = @vec_push v Item.{ 40 } |> \v = @vec_push v Item.{ 2 },
        .best = Item.{ 7 }
    }

$ test : @Int = 0

$ @e <| assert (test == 0) "REACH_MID: a check failed"
