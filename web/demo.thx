@mod MAIN

# The Thrax web playground demo. Compiled to wasm by the ccg backend and run in
# the browser; `main` is a Str, so the runtime prints it. It reads the compile-
# time `TARGET` reflection (which the platform layer fixes per target) so the
# same source visibly reports the target it was built for.

$ with STR

$ fib : Int -> Int = \n =
	if n ?< 2 => n else fib (n - 1) + fib (n - 2)

$ main : Str =
	"Thrax on " ++ TARGET.name
	++ " (" ++ STR.from_int TARGET.int_bits ++ "-bit word); "
	++ "fib 20 = " ++ STR.from_int (fib 20)
