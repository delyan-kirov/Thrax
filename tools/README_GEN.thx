@mod README_GEN

# \file README_GEN.thx
# \info Parse and test examples in readme and generate the README file

# A compile-time assertion (see examples/CT_ASSERT.thx): performs `<@meta>`, so it
# is discharged by `$ @run`. A false condition aborts the build with the message.
$ assert : @bool -> @str -> <@meta> {} = \ok msg = if ok => {} else @abort msg

# Force an already-parsed `@code` and discard it, returning `{}`. Parsing happens
# inside `@parse_items`/`@parse_str` (which trap on a syntax error); wrapping the
# result so it is NOT `@code` means item-position `$ @e (validate (...))` VALIDATES
# without injecting the parsed items (a bare `$ @e (@parse_items ..)` would inject).
$ validate : @code -> {} = \_ = {}

# ---- Markdown helpers -----------------------------------------------------

$ nl : @str = "\n"
$ fence : @str -> @str = \code = "```thrax\n" ++ code ++ "\n```\n"
$ sh : @str -> @str = \code = "```sh\n" ++ code ++ "\n```\n"

# ---- Examples (the source of truth) ---------------------------------------

$ ex_struct : @str =
	"$ Person : @struct = name: @str, age: @int,\n"
	++ "$ person : Person = Person.{ .name = \"Will\", .age = 21 }\n"
	++ "$ who    : @str = person.name\n"
	++ "$ older  : @int = person.age + 1\n"
	++ "\n"
	++ "# Generic: one declaration, two instantiations.\n"
	++ "$ Box  : @struct t = val: t,\n"
	++ "$ ibox : Box @int = Box.{ .val = 7 }\n"
	++ "$ sbox : Box @str = Box.{ .val = \"hi\" }"

$ ex_splice_struct : @str =
	"$ Point  : @struct = x: @int, y: @int,\n"
	++ "$ Point3 : @struct = with Point, z: @int,   # x, y, then z"

$ ex_union : @str =
	"$ Maybe : @union t = Just: {t}, None: {},\n"
	++ "\n"
	++ "$ some_i : Maybe @int = Maybe.Just.{ 5 }\n"
	++ "$ none_i : Maybe @int = Maybe.None\n"
	++ "\n"
	++ "$ List : @union t = Cons: {t, List t}, Nil: {},"

$ ex_splice_union : @str =
	"$ Base  : @union = Red: {}, Green: {},\n"
	++ "$ Color : @union = with Base, Blue: {}   # Red, Green, then Blue"

$ ex_match : @str =
	"$ grade : Maybe @int -> @int = \\m =\n"
	++ "\tis m\n"
	++ "\t\t| .Just.{ v } if v > 100 => 3\n"
	++ "\t\t| .Just.{ v } if v > 0   => 2\n"
	++ "\t\t| .Just.{ _ }             => 1\n"
	++ "\t\t| .None                   => 0\n"
	++ "\t\telse - 1"

$ ex_effect : @str =
	"$ Yield : @effect = yield : @int -> {},\n"
	++ "\n"
	++ "# The handler resumes once per yield, summing every value it produces.\n"
	++ "$ sumGen : ({} -> <Yield> {}) -> @int = \\gen =\n"
	++ "\tdo gen {}\n"
	++ "\tctl k | Yield.yield v => v + k {}\n"
	++ "\t      else _ => 0"

# A self-contained expression we can actually RUN and check at build time.
$ ex_expr : @str = "let sq = \\x = x * x in sq 3 + sq 4"

$ ex_ffi : @str =
	"$ puts : @str -> <@io> @int = @extern \"C\" \"puts\" \"libc\"\n"
	++ "$ main : {} -> <| e> @int = \\_ = puts \"Hello world\"; 0"

# ---- Compile-time validation ("unit tests") -------------------------------
# A malformed declaration or a wrong expected value fails the build here.

$ @e (validate (@parse_items ex_struct))
$ @e (validate (@parse_items ex_splice_struct))
$ @e (validate (@parse_items ex_union))
$ @e (validate (@parse_items ex_splice_union))
$ @e (validate (@parse_items ex_match))
$ @e (validate (@parse_items ex_effect))
$ @e (validate (@parse_items ex_ffi))
$ @run (assert (@eval (@parse_str ex_expr) == 25) "ex_expr should evaluate to 25")

# ---- README assembly ------------------------------------------------------

$ header : @str =
	"# Thrax\n\n"
	++ "> This file is GENERATED by `tools/README_GEN.thx`, the single source of\n"
	++ "> truth for its examples (each is validated at build time). Do not edit by\n"
	++ "> hand; edit the generator and regenerate with `thrax run tools/README_GEN.thx`.\n\n"
	++ "Thrax is a functional language with algebraic data types (structs *and* sum\n"
	++ "types), pattern matching, and typed **algebraic effects with handlers**. It\n"
	++ "compiles to native C, cross-compiles to WebAssembly, and can also be interpreted.\n"

$ links : @str =
	"\n## Links\n\n"
	++ "- **[Try it in your browser](https://delyan-kirov.github.io/Thrax/)**\n"
	++ "- **[Source on GitHub](https://github.com/delyan-kirov/Thrax)**: the compiler, standard library, and docs.\n"
	++ "- **[Examples](examples/)**: a small program for each feature (also the test corpus).\n"

$ building : @str =
	"\n## Building\n\n"
	++ "**With nix** (recommended):\n\n"
	++ sh ("nix develop      # dev shell; `thrax` is already on PATH here\n"
	     ++ "cargo build      # or build it yourself: target/debug/thrax\n"
	     ++ "cargo test       # the frontend, interpreter, and backend suites")
	++ "\n**Without nix**: any host with a recent `cargo`/`rustc` and a C toolchain:\n\n"
	++ sh "cargo build --release   # target/release/thrax"

$ compiling : @str =
	"\n## Compiling and running\n\n"
	++ "`thrax` takes a subcommand and, optionally, a `.thx` file. With no file it\n"
	++ "uses `MAIN.thx` in the current directory.\n\n"
	++ sh ("thrax run     examples/FIB.thx   # run under the interpreter\n"
	     ++ "thrax check   examples/FIB.thx   # type-check only, print inferred types\n"
	     ++ "thrax emit-c  examples/FIB.thx   # print the generated C (native backend)\n"
	     ++ "thrax build   examples/FIB.thx   # compile to a native executable\n"
	     ++ "thrax --target=wasm32-wasi build examples/FIB.thx   # cross-compile to wasm")

$ features : @str =
	"\n## Features\n\n"
	++ "- **Algebraic data types**: structs and sum types, generic by default, composed with `with`-splicing.\n"
	++ "- **Pattern matching**: nested, literal, string, and range patterns, `..rest`, and fall-through guards.\n"
	++ "- **Typed algebraic effects with handlers**: the effect row is part of the type; continuations are first-class and resumable.\n"
	++ "- **A native C backend**: the whole IR, effects included, lowers to self-contained C via a CEK machine, with reference-counted memory.\n"
	++ "- **C FFI with no ceremony**: `@extern \"C\" \"sym\" \"lib\"` binds a foreign function; C structs pass by value both ways.\n"
	++ "- **WebAssembly**: cross-compile with `--target=wasm32-wasi`, or run the whole compiler in the browser.\n"
	++ "- **And more**: row-polymorphic records, codata and streams, sized tensors, implicit (`@ctx`) parameters, function overloading, tail-call optimization, and compile-time metaprogramming (`@e` / `@run`).\n"

$ tour : @str =
	"\n## A tour of the language\n\n"
	++ "Every snippet below is validated when this README is generated.\n\n"
	++ "### Structs\n\n"
	++ "Structs are named records; a free lowercase name in a field type is an\n"
	++ "implicit type parameter, so declarations are generic.\n\n"
	++ fence ex_struct
	++ "\nA declaration may start with `with Other` to splice in another struct's\n"
	++ "fields (a copy-paste convenience, not subtyping).\n\n"
	++ fence ex_splice_struct
	++ "\n### Unions and pattern matching\n\n"
	++ "Sum types are a tagged choice of a variant and its payload; a `{}` payload is\n"
	++ "the unit variant. Unions take `with` too.\n\n"
	++ fence ex_union
	++ nl ++ fence ex_splice_union
	++ "\n`is scrut | pat => e ... else d` matches top to bottom; each arm may carry an\n"
	++ "`if <guard>` that falls through to the next arm on failure.\n\n"
	++ fence ex_match
	++ "\n### Algebraic effects and handlers\n\n"
	++ "An effect is a set of operations; performing one is just a call. A function's\n"
	++ "type carries the effects it may perform as a **row** on its arrow (`A -> <E> B`);\n"
	++ "a plain arrow is pure, and an unhandled effect is a compile-time error. Because\n"
	++ "the continuation `k` is first-class, generators, coroutines, and state are\n"
	++ "ordinary library code.\n\n"
	++ fence ex_effect

$ ffi : @str =
	"\n## Native backend and FFI\n\n"
	++ "Thrax lowers the whole IR to self-contained C, algebraic effects included, via\n"
	++ "a CEK-style machine emitted in C. Foreign C functions are bound with `@extern`;\n"
	++ "the library name is symbolic (no path or soname in source).\n\n"
	++ fence ex_ffi

$ layout : @str =
	"\n## Project layout\n\n"
	++ "| Directory | Contents |\n"
	++ "| --- | --- |\n"
	++ "| `crates/frontend` | lexer, parser, type checker, lowering, IR |\n"
	++ "| `crates/interpreter` | the reified-K (CEK) machine and the `@extern` FFI |\n"
	++ "| `crates/ccg` | the C backend (emits standalone C plus its runtime) |\n"
	++ "| `crates/thrax` | the `thrax` driver (CLI) |\n"
	++ "| `library/` | the standard library (`C` libc namespace, `CORE`, and the rest) |\n"
	++ "| `examples/` | annotated `.thx` programs (also the test corpus) |\n"
	++ "| `tools/` | dev tooling, incl. this README generator |\n"
	++ "| `documentation/` | language spec and design notes |\n"

$ footer : @str =
	"\n## License\n\n"
	++ "MIT, see [LICENSE](LICENSE).\n"

$ readme : @str =
	header ++ links ++ building ++ compiling ++ features ++ tour ++ ffi ++ layout ++ footer

# ---- Write the file via the C library (fopen/fputs/fclose) ----------------

$ write_all : @str -> @str -> <@io> @int = \path content =
	let f = C.fopen {path, "wb"} in
	if f == 0 => 0 - 1
	else
		C.fputs {content, f};
		C.fclose f

$ main : {} -> <| e> @int =
	let rc = write_all "README.md" readme in
	if rc == 0 => 0 else 1
