$ @mod HOOKS

#-
 - \file HOOKS.thx
 - \info The git hooks, which tools/hooks/* hand to `thxdo hook NAME ARGS`
 - \note documentation/workflow.md describes the workflow they add up to.
 -#

$ with IO
$ with OPT
$ with STR
$ with VEC
$ with RESULT
$ with SH
$ with FORGE

$ trunk : @Str = "master"

$ hook : @Vec @Str -> <Forge, @IO, Fail> {} = \args =>
    arg_at args 2 |> \
        | "pre-commit"            => pre_commit {}
        | "commit-msg"            => commit_msg (arg_at args 3)
        | "post-commit"           => post_commit {}; editors_refresh {}
        | "pre-push"              => pre_push {}
        | "post-checkout"         =>
            (if arg_at args 5 == "1" => sync_trunk {} else {}); editors_refresh {}
        | "post-merge" =>
            (if STR.is_empty (env "THXDO_SYNCING") => prune_merged {} else {}); editors_refresh {}
        | "editors-pre-commit"    => editors_pre_commit {}
        | "editors-post-commit"   => editors_post_commit {}
        | "editors-post-checkout" => editors_refresh {}
        | "editors-post-merge"    => editors_refresh {}
        | "open-pr"               => open_pr (arg_at args 3) (arg_at args 4)
        | other                   => Fail.fail ("unknown hook `" ++ other ++ "`")

# The issue a commit subject names: `#351 Fix it` is 351.
$ subject_issue : @Str -> Option @Int = \s =>
    if STR.starts_with s "#" => number_before s 1 " " else Option.None

# The issue a branch is for: `351-fix-it` is 351.
$ branch_issue : @Str -> Option @Int = \b => number_before b 0 "-"

# At most 40 bytes, cut between words.
$ slug : @Str -> @Str = \title =>
    let s = squeeze (STR.to_lower title) 0 "" in
    if STR.len s <= 40 =>
        trim_dashes s
    else if STR.at s 40 == 45 =>
        STR.substr s 0 40
    else
        trim_dashes (STR.substr s 0 (last_dash s 40))

# Every editor brought up to date with the grammar: Zed's pin moved to its last
# commit, the highlight queries checked against it, the grammars Zed and Helix
# compile rebuilt, and VS Code's install repackaged. Neovim compiles nothing.
$ editors_update : {} -> <@IO, Fail> {} = \u =>
    pin_zed_grammar {};
    check_queries {};
    zed_build {};
    (if helix_installed {} => helix_build {} else {});
    if vscode_installed {} => vscode_build {} else {}

# What the editors use rebuilt when it is missing or older than its sources, so
# a commit, checkout or pull never leaves an editor without it. Only for the
# editors that have Thrax installed.
$ editors_refresh : {} -> <@IO, Fail> {} = \u =>
    let ext = editors ++ "/zed/" in
    let parser = [editors ++ "/tree-sitter-thrax/src/parser.c"] in
    let srcs = VEC.append
        (VEC.map (\f => ext ++ "src/" ++ f) (read_dir (ext ++ "src"))) [
            ext ++ "Cargo.toml",
            ext ++ "extension.toml"
        ] in
    (
        if zed_installed {}
            && (
                out_of_date (ext ++ "extension.wasm") srcs
                    || out_of_date (ext ++ "grammars/thrax.wasm") parser
            ) =>
            say "rebuilding the Zed extension ...";
            zed_build {};
            say "Zed extension rebuilt, restart Zed to load it"
        else
            {}
    );
    (
        if vscode_installed {}
            && out_of_date vsix (VEC.map (\f => editors ++ "/vscode/" ++ f) vscode_srcs) =>
            say "reinstalling the VS Code extension ...";
            vscode_build {};
            say "VS Code extension reinstalled, reload VS Code to load it"
        else
            {}
    );
    if helix_installed {} && out_of_date (helix_grammar {}) parser =>
        say "rebuilding the Helix grammar ..."; helix_build {}; say "Helix grammar rebuilt"
    else
        {}

$ @private

$ arg_at : @Vec @Str -> @Int -> @Str = \args i => if @vec_len args <= i => "" else @vec_get args i

$ say : @Str -> <@IO> {} = \msg => eprintln ("thxdo: " ++ msg)

$ sh : @Str -> <@IO, Fail> {} = \cmd =>
    if succeeds cmd => {} else Fail.fail ("`" ++ cmd ++ "` failed")

$ current_branch : {} -> <@IO> @Str = \u => output "git branch --show-current"

$ first_line : @Str -> @Str = \s => OPT.unwrap_or (VEC.first (STR.lines s)) ""

$ digits_end : @Str -> @Int -> @Int = \s i =>
    if i < STR.len s && STR.is_digit (STR.at s i) => digits_end s (i + 1) else i

# The number at `from`, when the digits run to the end of `s` or into `sep`.
$ number_before : @Str -> @Int -> @Str -> Option @Int = \s from sep =>
    let j = digits_end s from in
    if j == from =>
        Option.None
    else if j == STR.len s || STR.starts_with (STR.substr s j (STR.len s)) sep =>
        STR.to_int (STR.substr s from j)
    else
        Option.None

$ squeeze : @Str -> @Int -> @Str -> @Str = \s i acc =>
    if i >= STR.len s =>
        acc
    else
        let c = STR.at s i in
        if STR.is_alnum c =>
            squeeze s (i + 1) (@array_push acc c)
        else if STR.is_empty acc || STR.ends_with acc "-" =>
            squeeze s (i + 1) acc
        else
            squeeze s (i + 1) (@array_push acc 45)

# The index of the last `-` before `i`, or `i` when there is none.
$ last_dash : @Str -> @Int -> @Int = \s i => last_dash_from s i (i - 1)

$ last_dash_from : @Str -> @Int -> @Int -> @Int = \s i j =>
    if j <= 0 => i else if STR.at s j == 45 => j else last_dash_from s i (j - 1)

$ trim_dashes : @Str -> @Str = \s =>
    if STR.ends_with s "-" => trim_dashes (STR.substr s 0 (STR.len s - 1)) else s

$ dir_of : @Str -> @Str = \path =>
    let parts = STR.split path "/" in
    if @vec_len parts <= 1 => "" else STR.join "/" (VEC.init parts) ++ "/"

# ---- pre-commit ----

# Checks picked by what is staged. The .thx files are formatted in the index
# (and in the working tree when it matches), the rest only checked.
$ pre_commit : {} -> <@IO, Fail> {} = \u =>
    let staged = STR.lines (output "git diff --cached --name-only --diff-filter=ACMR") in
    let thx =
        VEC.filter (\f => STR.ends_with f ".thx" && !(STR.starts_with f "tests/diagnostics/"))
            staged
    in
    let bad = unformatted thx 0 [] in
    (
        if VEC.is_empty bad =>
            {}
        else
            Fail.fail ("not formatted, commit stopped: " ++ STR.join ", " bad)
    );
    (
        if VEC.any (\f => STR.ends_with f ".rs" || STR.ends_with f "Cargo.toml") staged =>
            say "cargo check ..."; sh "cargo check --workspace --quiet"
        else
            {}
    );
    (
        if VEC.any (\f => f == "documentation/thrax.y") staged =>
            say "grammar check ..."; sh "bison -o /dev/null documentation/thrax.y"
        else
            {}
    );
    if VEC.any (\f => f == editors) staged =>
        let c = output ("git rev-parse :" ++ editors) in
        let pinned =
            pinned_rev (output ("git -C " ++ editors ++ " show " ++ c ++ ":zed/extension.toml")) in
        if pinned == grammar_rev c =>
            {}
        else
            Fail.fail
                (
                    "the staged "
                        ++ editors
                        ++ " pins the Zed grammar at an older commit\n"
                        ++ "help: `thxdo editors-update`, commit zed/extension.toml in "
                        ++ editors
                        ++ ", then stage it here"
                )
    else
        {}

$ unformatted : @Vec @Str -> @Int -> @Vec @Str -> <@IO, Fail> @Vec @Str = \fs i acc =>
    if i >= @vec_len fs =>
        acc
    else
        let f = @vec_get fs i in
        unformatted fs (i + 1) (if fmt_staged f => acc else @vec_push acc f)

# The STAGED version is formatted, so a partially staged file commits only its
# staged hunks. tests/diagnostics/ is exempt: its files pin error positions.
$ fmt_staged : @Str -> <@IO, Fail> @Bool = \f =>
    let thrax = if STR.is_empty (env "THRAX_BIN") => "thrax" else env "THRAX_BIN" in
    let
    # Beside the original, so `thrax fmt` finds the same BUILD.thx.
    tmp =
        dir_of f ++ ".fmt.thxdo." ++ VEC.get_or (VEC.reverse (STR.split f "/")) 0 f
    in
    let staged = (capture ("git show " ++ quote (":" ++ f))).out in
    write_file tmp staged;
    if !(succeeds (thrax ++ " fmt " ++ quote tmp ++ " 2>/dev/null")) =>
        say ("thrax fmt refused " ++ f ++ ":");
        eprint (STR.replace (capture (thrax ++ " fmt --check " ++ quote tmp ++ " 2>&1")).out tmp f);
        remove_file tmp;
        @false
    else
        let formatted = OPT.unwrap_or (read_file tmp) staged in
        if formatted == staged =>
            remove_file tmp; @true
        else
            let mode =
                OPT.unwrap_or
                    (VEC.first (STR.split (output ("git ls-files -s -- " ++ quote f)) " ")) "100644"
            in
            let blob = output ("git hash-object -w -- " ++ quote tmp) in
            (if OPT.unwrap_or (read_file f) "" == staged => write_file f formatted else @true);
            sh ("git update-index --cacheinfo " ++ quote (mode ++ "," ++ blob ++ "," ++ f));
            remove_file tmp;
            say ("formatted " ++ f);
            @true

# ---- the Zed extension ----

$ editors : @Str = "tools/editors"

$ zed_toml : @Str = "tools/editors/zed/extension.toml"

$ rev_line : @Str -> @Str = \rev => "rev = \"" ++ rev ++ "\""

# The `rev` an extension.toml pins the grammar at.
$ pinned_rev : @Str -> @Str = \toml =>
    let line = OPT.unwrap_or (VEC.find (\l => STR.starts_with l "rev = ") (STR.lines toml)) "" in
    STR.replace (STR.replace line "rev = " "") "\"" ""

# The last commit up to `c` in tools/editors that changed the grammar.
$ grammar_rev : @Str -> <@IO> @Str = \c =>
    output ("git -C " ++ editors ++ " log -1 --format=%H " ++ c ++ " -- tree-sitter-thrax")

$ pin_zed_grammar : {} -> <@IO> {} = \u =>
    let rev = grammar_rev "HEAD" in
    let text = OPT.unwrap_or (read_file zed_toml) "" in
    let old = pinned_rev text in
    (
        if rev != old =>
            write_file zed_toml (STR.replace text (rev_line old) (rev_line rev));
            say
                (
                    "the Zed grammar is pinned at "
                        ++ rev
                        ++ ", commit zed/extension.toml in "
                        ++ editors
                )
        else
            {}
    );
    if STR.is_empty (output ("git -C " ++ editors ++ " branch -r --contains " ++ rev)) =>
        say ("Zed fetches the grammar from the remote, and " ++ rev ++ " is not pushed")
    else
        {}

# The highlight queries name the grammar's node types, so a regenerated grammar
# can leave them naming one that is gone, and Helix and Zed then drop them.
$ queries : @Vec @Str = ["helix/queries/thrax/highlights.scm", "zed/languages/thrax/highlights.scm"]

$ check_queries : {} -> <@IO, Fail> {} = \u =>
    let bad = bad_queries 0 [] in
    if VEC.is_empty bad =>
        {}
    else
        Fail.fail
            (
                "highlight queries do not match the grammar:\n  "
                    ++ STR.join "\n  " bad
                    ++ "\nhelp: rename the node types the grammar renamed"
            )

$ bad_queries : @Int -> @Vec @Str -> <@IO> @Vec @Str = \i acc =>
    if i >= @vec_len queries =>
        acc
    else
        let q = @vec_get queries i in
        let r = capture
            (
                "cd "
                    ++ editors
                    ++ "/tree-sitter-thrax && nix develop path:.. -c tree-sitter query ../"
                    ++ q
                    ++ " ../TAGS.thx 2>&1 >/dev/null"
            ) in
        let why = VEC.filter (\l => STR.contains l "error") (STR.lines r.out) in
        bad_queries (i + 1) (if r.ok => acc else @vec_push acc (q ++ ": " ++ STR.join " " why))

# The hooks of the tools/editors repository (tools/editors/hooks), run from the
# Thrax root. A commit that changes the grammar moves Zed's pin to it, which is
# left for the next commit: a commit cannot name itself.
$ editors_pre_commit : {} -> <@IO, Fail> {} = \u =>
    let staged = STR.lines (output ("git -C " ++ editors ++ " diff --cached --name-only")) in
    let inputs = ["tree-sitter-thrax/", "helix/queries/", "zed/languages/"] in
    if VEC.any (\f => VEC.any (\p => STR.starts_with f p) inputs) staged =>
        say "checking the highlight queries ..."; check_queries {}
    else
        {}

$ editors_post_commit : {} -> <@IO, Fail> {} = \u =>
    let changed = STR.lines
        (output ("git -C " ++ editors ++ " diff-tree --no-commit-id --name-only -r HEAD")) in
    (
        if VEC.any (\f => STR.starts_with f "tree-sitter-thrax/") changed =>
            pin_zed_grammar {}
        else
            {}
    );
    editors_refresh {}

$ config_home : {} -> <@IO> @Str = \u =>
    if STR.is_empty (env "XDG_CONFIG_HOME") => env "HOME" ++ "/.config" else env "XDG_CONFIG_HOME"

# Helix has Thrax when it has compiled the grammar once (`hx --grammar build`).
$ helix_grammar : {} -> <@IO> @Str = \u => config_home {} ++ "/helix/runtime/grammars/thrax.so"

$ helix_installed : {} -> <@IO> @Bool = \u => is_some (mtime (helix_grammar {}))

# Only Thrax's grammar, compiled as `hx --grammar build` would: that builds every
# grammar Helix knows, and one failing elsewhere would stop it.
$ helix_build : {} -> <@IO, Fail> {} = \u =>
    let src = editors ++ "/tree-sitter-thrax/src" in
    sh
        (
            "cc -shared -fPIC -O3 -g0 -I "
                ++ src
                ++ " "
                ++ src
                ++ "/parser.c -o "
                ++ quote (helix_grammar {})
        )

# VS Code runs the packaged extension it installed, so a change reaches it only
# through a new package.
$ vsix : @Str = "tools/editors/vscode/thrax.vsix"

$ vscode_srcs : @Vec @Str = [
    "extension.js",
    "package.json",
    "language-configuration.json",
    "syntaxes/thrax.tmLanguage.json"
]

$ vscode_installed : {} -> <@IO> @Bool = \u =>
    succeeds "ls -d \"$HOME\"/.vscode/extensions/thrax.thrax-* >/dev/null 2>&1"

$ vscode_build : {} -> <@IO, Fail> {} = \u => sh
    (
        "cd "
            ++ editors
            ++ "/vscode"
            ++ " && { [ -d node_modules ] || npm install --no-audit --no-fund --silent; }"
            ++ " && npx --yes @vscode/vsce package -o thrax.vsix >/dev/null 2>&1"
            ++ " && code --install-extension thrax.vsix --force >/dev/null 2>&1"
    )

$ zed_installed : {} -> <@IO> @Bool = \u =>
    let data =
        if STR.is_empty (env "XDG_DATA_HOME") =>
            env "HOME" ++ "/.local/share"
        else
            env "XDG_DATA_HOME"
    in
    is_some (mtime (data ++ "/zed/extensions/installed/thrax"))

$ zed_build : {} -> <@IO, Fail> {} = \u =>
    sh ("nix run path:" ++ editors ++ "#zed-build -- " ++ editors)

# Whether `target` is missing or older than one of `srcs`.
$ out_of_date : @Str -> @Vec @Str -> <@IO> @Bool = \target srcs =>
    mtime target |> \ | Option.Some.{ t } => newer_than t srcs 0 | _ => @true

$ newer_than : @Int -> @Vec @Str -> @Int -> <@IO> @Bool = \t srcs i =>
    if i >= @vec_len srcs =>
        @false
    else
        OPT.unwrap_or (mtime (@vec_get srcs i)) 0 > t || newer_than t srcs (i + 1)

# ---- commit-msg / post-commit ----

# Where commit-msg leaves the branch a trunk commit moves to, for post-commit.
# `--no-verify` skips commit-msg, so no marker is left and the commit stays.
$ marker : {} -> <@IO> @Str = \u => output "git rev-parse --git-path thxdo-move"

$ exempt : @Str -> @Bool = \s =>
    VEC.any (\p => STR.starts_with s p) ["Merge ", "Revert ", "fixup!", "squash!", "amend!"]

$ is_new : @Str -> @Bool = \s => s == "#new" || STR.starts_with s "#new "

$ need_issue : @Str =
    "a commit on master names its issue\n"
        ++ "help: start the message with `#N` for issue N, or `#new <title>` to open one"

# On the trunk, every commit names an issue, `#new <title>` opening it. On an
# issue's branch, a message without one gets the branch's.
$ commit_msg : @Str -> <Forge, @IO, Fail> {} = \path =>
    let text = expect (read_file path) ("cannot read " ++ path) in
    let subject = first_line text in
    let branch = current_branch {} in
    remove_file (marker {});
    if exempt subject || STR.is_empty (STR.trim subject) =>
        {}
    else
        subject_issue subject |> \
            | Option.Some.{ n } =>
                let rest =
                    STR.trim (STR.substr subject (1 + STR.len (int_to_str n)) (STR.len subject)) in
                claim branch n (issue_title n rest)
            | _ =>
                if is_new subject =>
                    let title = STR.trim (STR.substr subject 4 (STR.len subject)) in
                    if STR.is_empty title =>
                        Fail.fail "`#new` needs a title, `#new <title>`"
                    else
                        let n = expect (Forge.create_issue title) "could not open the issue" in
                        say ("opened issue #" ++ int_to_str n);
                        write_file path ("#" ++ int_to_str n ++ STR.substr text 4 (STR.len text));
                        claim branch n title
                else
                    branch_issue branch |> \
                        | Option.Some.{ m } =>
                            write_file path ("#" ++ int_to_str m ++ " " ++ text); {}
                        | _                 => if branch == trunk => Fail.fail need_issue else {}

# The open issue's title. `fallback` when the forge does not answer, so working
# offline only loses the check.
$ issue_title : @Int -> @Str -> <Forge, @IO, Fail> @Str = \n fallback =>
    Forge.issue n |> \
        | .Found.{ i } =>
            if i.open => i.title else Fail.fail ("issue #" ++ int_to_str n ++ " is closed")
        | .Missing     => Fail.fail
            (
                "there is no issue #"
                    ++ int_to_str n
                    ++ "\nhelp: `#new <title>` opens one for the commit"
            )
        | .Unreachable => say "the forge did not answer, the issue is unchecked"; fallback

$ issue_branch : @Int -> <@IO> @Str = \n => first_line
    (output ("git for-each-ref --format='%(refname:short)' 'refs/heads/" ++ int_to_str n ++ "-*'"))

# A commit for issue `n`, made on `branch`. On the trunk it is marked to move to
# the issue's branch; on another issue's branch it is refused.
$ claim : @Str -> @Int -> @Str -> <@IO, Fail> {} = \branch n title =>
    let num = int_to_str n in
    branch_issue branch |> \
        | Option.Some.{ m } =>
            if m == n =>
                {}
            else
                Fail.fail
                    (
                        "this commit is for #"
                            ++ num
                            ++ ", but `"
                            ++ branch
                            ++ "` is the branch of #"
                            ++ int_to_str m
                            ++ "\nhelp: `git switch master` and commit there"
                    )
        | _ =>
            if branch == trunk =>
                let existing = issue_branch n in
                if STR.is_empty existing =>
                    let s = slug title in
                    write_file (marker {}) (if STR.is_empty s => num else num ++ "-" ++ s); {}
                else
                    Fail.fail
                        (
                            "#"
                                ++ num
                                ++ " already has the branch `"
                                ++ existing
                                ++ "`\nhelp: `git switch "
                                ++ existing
                                ++ "` and commit there"
                        )
            else
                {}

# The commit leaves the trunk for its issue's branch. Only refs move: the new
# branch holds the commit just made, so the index and working tree already
# match it.
$ post_commit : {} -> <@IO, Fail> {} = \u =>
    let m = marker {} in
    read_file m |> \
        | Option.Some.{ text } =>
            remove_file m;
            let branch = STR.trim text in
            let head = output "git rev-parse HEAD" in
            if current_branch {} == trunk && !(STR.is_empty head) =>
                sh ("git branch " ++ quote branch ++ " " ++ head);
                sh ("git symbolic-ref HEAD refs/heads/" ++ branch);
                sh ("git update-ref refs/heads/" ++ trunk ++ " " ++ head ++ "~1 " ++ head);
                say ("the commit moved to `" ++ branch ++ "`; `git push` opens its pull request")
            else
                {}
        | _ => {}

# ---- pre-push / open-pr ----

# git passes `<local ref> <local sha> <remote ref> <remote sha>` per ref.
$ pre_push : {} -> <@IO, Fail> {} = \u => push_lines (read_line {})

$ push_lines : @Str -> <@IO, Fail> {} = \line =>
    if STR.is_empty line =>
        {}
    else
        let parts = STR.split line " " in
        let sha = arg_at parts 1 in
        let branch = STR.replace (arg_at parts 2) "refs/heads/" "" in
        (
            if branch == trunk =>
                Fail.fail
                    (
                        "master changes through pull requests\n"
                            ++ "help: commit on master with `#N <subject>` and the commit moves to its branch;"
                            ++ " `git push --no-verify` pushes anyway"
                    )
            else if STR.starts_with sha "0000000000" =>
                {}
            else if is_some (branch_issue branch) =>
                spawn_open_pr branch sha
            else
                {}
        );
        push_lines (read_line {})

# The pull request can only be opened once the branch is on the remote, which
# is after this hook returns, so a detached helper waits for it.
$ spawn_open_pr : @Str -> @Str -> <@IO> {} = \branch sha =>
    let thxdo = if STR.is_empty (env "THXDO_BIN") => "thxdo" else env "THXDO_BIN" in
    C.system
        (
            "("
                ++ quote thxdo
                ++ " hook open-pr "
                ++ quote branch
                ++ " "
                ++ quote sha
                ++ " </dev/null &)"
        );
    {}

$ open_pr : @Str -> @Str -> <Forge, @IO, Fail> {} = \branch sha =>
    if !(reached branch sha 60) =>
        {}
    else
        Forge.pr branch |> \
            | .Absent =>
                let n = OPT.unwrap_or (branch_issue branch) 0 in
                let subjects = STR.lines
                    (
                        output
                            (
                                "git log --reverse --format=%s origin/"
                                    ++ trunk
                                    ++ ".."
                                    ++ quote branch
                            )
                    ) in
                let title =
                    OPT.unwrap_or (VEC.find (\s => OPT.unwrap_or (subject_issue s) 0 == n) subjects)
                        branch
                in
                (
                    Forge.open_pr
                        PrSpec.{
                            .branch = branch,
                            .base = trunk,
                            .title = title,
                            .body = "Closes #" ++ int_to_str n
                        }
                        |> \
                            | Option.Some.{ url } => say ("opened " ++ url)
                            | _                   =>
                                say ("could not open a pull request for `" ++ branch ++ "`")
                )
            | .Open.{ url } => {}
            | .Merged       => say ("`" ++ branch ++ "` was merged already, no pull request opened")
            | .Closed       => say
                ("the pull request of `" ++ branch ++ "` is closed, reopen it to review this push")

$ reached : @Str -> @Str -> @Int -> <@IO> @Bool = \branch sha tries =>
    if STR.starts_with (output ("git ls-remote origin " ++ quote ("refs/heads/" ++ branch))) sha =>
        @true
    else if tries <= 0 =>
        @false
    else
        C.system "sleep 1"; reached branch sha (tries - 1)

# ---- post-checkout / post-merge ----

# Arriving on the trunk brings it up to date and drops the branches whose pull
# requests merged. THXDO_SYNCING keeps post-merge from pruning a second time.
$ sync_trunk : {} -> <Forge, @IO, Fail> {} = \u =>
    if current_branch {} == trunk =>
        C.system "git fetch -q --prune origin";
        C.system ("THXDO_SYNCING=1 git merge -q --ff-only origin/" ++ trunk ++ " 2>/dev/null");
        prune_merged {}
    else
        {}

$ prune_merged : {} -> <Forge, @IO, Fail> {} = \u =>
    let here = current_branch {} in
    let branches = STR.lines (output "git for-each-ref --format='%(refname:short)' refs/heads/") in
    for branches (\b =>
        if b != here && is_some (branch_issue b) =>
            (
                Forge.pr b |> \
                    | .Merged =>
                        sh ("git branch -q -D " ++ quote b);
                        say ("deleted `" ++ b ++ "`, its pull request merged")
                    | _ => {}
            )
        else
            {})
