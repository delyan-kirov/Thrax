#!/bin/sh
# Every hook in this directory is `run <hook> <git's arguments>`. The logic is
# Ares, in tools/HOOKS.ares, reached through `thrax hook`. Installed by
# `thrax hooks` (and on entering the nix shell); `--no-verify` skips the
# commit and push checks, which are refused outside the nix shell.
case $1 in
pre-commit | commit-msg | pre-push)
    [ -n "$IN_NIX_SHELL" ] || {
        echo "thrax: $1 refused outside the nix shell" >&2
        echo "help: run git from \`nix develop\`; \`--no-verify\` skips the check" >&2
        exit 1
    }
    ;;
esac
thrax=$(command -v thrax) || {
    echo "thrax: not on PATH (outside the nix shell?), $1 hook skipped" >&2
    exit 0
}
THRAX_BIN=$thrax exec "$thrax" hook "$@"
