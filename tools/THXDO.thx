@mod THXDO

#-
 - \file THXDO.thx
 - \info Thrax task runner
 -#

$ with IO
$ with OPT
$ with STR

$ help_text : @str
     = "thxdo - the Thrax task runner (tasks live in tools/THXDO.thx)\n"
	++ "\n"
	++ "Usage: thxdo <command>\n"
	++ "\n"
	++ "Commands:\n"
	++ "  build     clean, then build the compiler workspace\n"
	++ "  rebuild   build the workspace without cleaning\n"
	++ "  clean     remove build artifacts\n"
	++ "  readme    regenerate README.md from tools/README_GEN.thx\n"
	++ "  corpus    run tests/MAIN.thx on both engines (interpreter + native C)\n"
	++ "  grammar   check documentation/thrax.y with bison (-v for counterexamples)\n"
	++ "  doc       build the rustdoc for the workspace and open it in a browser\n"
	++ "  site      rebuild the web playground's wasm, then serve it and open it\n"
	++ "  start N   branch N-<slug> off origin/master for issue N (or switch to it)\n"
	++ "  done      switch to master, pull, delete the branch if its PR merged\n"
	++ "  issue     create a GitHub issue (extra args go to `gh issue create`)\n"
	++ "  sdk_path  print the repo root (source tools/thxdo.nu to cd there)\n"
	++ "  stats     line counts (tokei, excluding external/ and applications/)\n"
	++ "  all       build, then regenerate README.md\n"
	++ "  help      show this help\n"

$ readme_cmd : @str = "${THRAX_BIN:-thrax} run tools/README_GEN.thx"

$ thrax_bin : @str = "${THRAX_BIN:-thrax}"

# The combined corpus. `cargo test` does not cover it, so this is the only thing
# that catches a break in the examples or the standard library. Both engines, and
# their output must match: the C backend is only correct if it agrees.
$ corpus_cmd : @str =
	thrax_bin ++ " run tests/MAIN.thx > /tmp/thx-corpus-interp.txt && "
	++ thrax_bin ++ " build tests/MAIN.thx >/dev/null && "
	++ "./tests/thrax-out/MAIN > /tmp/thx-corpus-native.txt && "
	++ "diff /tmp/thx-corpus-interp.txt /tmp/thx-corpus-native.txt && "
	++ "cat /tmp/thx-corpus-interp.txt"

# `%expect` in the grammar is a tripwire: bison fails when the conflict count
# moves, so a syntax change has to be accounted for in the spec.
$ grammar_cmd : @str = "bison -o /dev/null documentation/thrax.y"

$ grammar_verbose_cmd : @str =
	"bison -Wcounterexamples -o /dev/null documentation/thrax.y"

$ doc_page : @str = "target/doc/thrax/index.html"

$ doc_open_cmd : @str =
	"( ${BROWSER:-xdg-open} \"$PWD/" ++ doc_page ++ "\" >/dev/null 2>&1 & )"

$ site_url : @str = "http://localhost:8000"

# The playground links with wasm-ld, which only the web app's own dev shell
# carries (applications/web/flake.nix), so the build runs inside it.
$ site_build_cmd : @str =
	"nix develop ./applications/web --command node applications/web/build.mjs"

$ site_serve_cmd : @str = "node applications/web/serve.mjs"

# The server holds the terminal, so the browser has to be launched before it,
# and after a moment so it does not beat the listen.
$ site_open_cmd : @str =
	"( sleep 1; ${BROWSER:-xdg-open} \"" ++ site_url ++ "\" >/dev/null 2>&1 & )"

# Uncommitted changes would silently ride along to the other branch.
$ clean_tree_check : @str =
	"if ! git diff --quiet || ! git diff --cached --quiet; then "
	++ "echo 'thxdo: uncommitted changes, commit or stash them first' >&2; exit 1; fi; "

# An existing branch for the issue is reused, so `start N` also means "go back
# to N". `--no-track` keeps the branch from adopting origin/master as upstream.
$ start_cmd : @str -> @str = \n =
	"set -e; n=" ++ n ++ "; "
	++ clean_tree_check
	++ "b=$(git for-each-ref --format='%(refname:short)' \"refs/heads/$n-*\" | head -n 1); "
	++ "if [ -n \"$b\" ]; then git switch \"$b\"; exit 0; fi; "
	++ "title=$(gh issue view \"$n\" --json title -q .title); "
	++ "slug=$(printf '%s' \"$title\" | tr 'A-Z' 'a-z' | tr -cs 'a-z0-9' '-' "
	++ "| cut -c 1-40 | sed 's/^-*//; s/-*$//'); "
	++ "git fetch --quiet origin master; "
	++ "git switch --no-track -c \"$n-$slug\" origin/master; "
	++ "echo \"thxdo: on $n-$slug ($title)\""

# PRs are squash-merged, so a merged branch is never an ancestor of master and
# `git branch -d` refuses it. GitHub's PR state is the merge signal instead.
$ done_cmd : @str =
	"set -e; b=$(git branch --show-current); "
	++ "if [ \"$b\" != master ]; then " ++ clean_tree_check ++ "git switch master; fi; "
	++ "git pull --ff-only; "
	++ "if [ -n \"$b\" ] && [ \"$b\" != master ]; then "
	++ "state=$(gh pr view \"$b\" --json state -q .state 2>/dev/null || echo NONE); "
	++ "if [ \"$state\" = MERGED ]; then git branch -D \"$b\"; "
	++ "else echo \"thxdo: kept $b (PR: $state)\"; fi; fi"

$ sh_quote : @str -> @str = \s = "'" ++ STR.replace s "'" "'\\''" ++ "'"

$ quoted_from : @vec @str -> @int -> @str = \args, i =
	if @vec_len args <= i => ""
	else " " ++ sh_quote (@vec_get args i) ++ quoted_from args (i + 1)

$ arg_or : @vec @str -> @int -> @str -> @str = \args, i, d =
	if @vec_len args <= i => d else @vec_get args i

$ run_command: @vec @str -> <@io> bool = \args =
	is @vec_get args 1
		| "build"   => C.system "cargo clean && cargo build"; @true
		| "test"    => C.system "cargo clean"; C.system "cargo test"; @true 
		| "rebuild" => C.system "cargo build"; @true
		| "clean"   => C.system "cargo clean"; @true
		| "install" => C.system "nix profile remove Thrax"; C.system "nix profile add"; @true
		| "issue"   => C.system ("gh issue create" ++ quoted_from args 2) == 0
		| "start"   =>
			(is STR.to_int (arg_or args 2 "")
				| Option.Some.{n} if n > 0 => C.system (start_cmd (int_to_str n)) == 0
				| _ => print "thxdo: usage: thxdo start <issue-number>\n"; @false)
		| "done"    => C.system done_cmd == 0
		| "readme"  =>
			println "thxdo: regenerating README.md ...";
			let rc = C.system readme_cmd in
			println (if rc == 0 => "thxdo: README.md updated" else "thxdo: readme FAILED");
			if 0 == rc => @true else @false
		| "corpus"  =>
			println "thxdo: running tests/MAIN.thx on both engines ...";
			let rc = C.system corpus_cmd in
				if rc == 0 => println "thxdo: corpus OK (engines agree)"; @true
				else println "thxdo: corpus FAILED"; @false
		| "grammar" =>
			println "thxdo: checking documentation/thrax.y ...";
			let rc = C.system grammar_cmd in
				if rc == 0 => println "thxdo: grammar OK"; @true
				else
					println "thxdo: grammar FAILED (counterexamples below)";
					C.system grammar_verbose_cmd;
					@false
		| "doc"     =>
			println "thxdo: building rustdoc ...";
			let rc = C.system "cargo doc --workspace --no-deps" in
				if rc == 0 =>
					println ("thxdo: opening " ++ doc_page); C.system doc_open_cmd;
					@true
				else
					println "thxdo: doc FAILED";
					@false
		| "site"     =>
			println "thxdo: rebuilding the playground wasm ...";
			let rc = C.system site_build_cmd in
				if rc == 0 =>
					println ("thxdo: serving " ++ site_url ++ " (Ctrl-C to stop)");
					C.system site_open_cmd;
					C.system site_serve_cmd;
					@true
				else
					println "thxdo: site build FAILED";
					@false
		| "sdk_path" => println (env "THRAX_ROOT"); @true
		| "stats"    => C.system "tokei --exclude external --exclude applications"; @true
		| "all"      =>
			C.system <|
				"cargo clean && cargo build && echo 'thxdo: regenerating README.md ...' && "
					++ readme_cmd;
			@true
		| "help"     => print help_text; @true
		| _ =>
			print ("thxdo: unknown command\n\n" ++ help_text);
			@false

#-
 - \args(1) : command
 - \note : if no command present, show help msg
 -#
$ @main : @vec @str -> <@io> @int = \args =
	if @vec_len args < 2 =>
		print help_text; 0
	else
		if run_command args => 0
		else 1
