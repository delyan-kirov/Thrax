$ setAudioStreamPitch : {p0: AudioStream, p1: @float32} -> {} = @extern "C" "SetAudioStreamPitch" "bin/libraylib.so"
$ setAudioStreamPan : {p0: AudioStream, p1: @float32} -> {} = @extern "C" "SetAudioStreamPan" "bin/libraylib.so"
$ setAudioStreamBufferSizeDefault : @int32 -> {} = @extern "C" "SetAudioStreamBufferSizeDefault" "bin/libraylib.so"
$ setAudioStreamCallback : {p0: AudioStream, p1: AudioCallback} -> {} = @extern "C" "SetAudioStreamCallback" "bin/libraylib.so"
$ attachAudioStreamProcessor : {p0: AudioStream, p1: AudioCallback} -> {} = @extern "C" "AttachAudioStreamProcessor" "bin/libraylib.so"
$ detachAudioStreamProcessor : {p0: AudioStream, p1: AudioCallback} -> {} = @extern "C" "DetachAudioStreamProcessor" "bin/libraylib.so"
$ attachAudioMixedProcessor : AudioCallback -> {} = @extern "C" "AttachAudioMixedProcessor" "bin/libraylib.so"
$ detachAudioMixedProcessor : AudioCallback -> {} = @extern "C" "DetachAudioMixedProcessor" "bin/libraylib.so"
