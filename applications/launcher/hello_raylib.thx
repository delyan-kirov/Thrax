@mod MAIN
$ with RAYLIB

# Mirror of hello_raylib.c: open a window and draw one screen until closed.
# A multi-parameter raylib call takes a record of its arguments (C has no
# first-class closures to curry), so `drawText` is passed `{ .p0 = ..., ... }`.
$ loop : {} -> {} =
	if windowShouldClose {} ?= 0 =>
		beginDrawing {} ;
		clearBackground (Color.{ .r = 30, .g = 30, .b = 46, .a = 255 }) ;
		drawText { .p0 = "If you can read this, Thrax+raylib works.", .p1 = 40, .p2 = 180, .p3 = 20,
		           .p4 = Color.{ .r = 232, .g = 232, .b = 240, .a = 255 } } ;
		endDrawing {} ;
		loop {}
	else closeWindow {}

$ main : {} -> <| e> Int = \u =
	initWindow { .p0 = 640, .p1 = 400, .p2 = "Thrax raylib hello" } ;
	setTargetFPS 60 ;
	loop {} ;
	0
