@mod MAIN

# \file MAIN.thx
# \info A minimal program launcher, written in Thrax against raylib. Click a
#       button to spawn the program it names. The raylib API is imported from
#       RAYLIB.thx, which is GENERATED by the cbindgen tool from raylib's header
#       (`Color` is a real `@struct @extern "C"` passed BY VALUE). A C function
#       is never curried, so a multi-parameter raylib call takes a record of its
#       arguments: `drawRectangle { .p0 = x, .p1 = y, ... }`. Run it from THIS
#       directory (the flake links `bin/libraylib.so` and `library/`):
#           nix develop   &&   thrax run MAIN.thx
#       Regenerate the bindings with:
#           LIB=bin/libraylib.so MOD=RAYLIB OUT=RAYLIB.thx \
#             thrax run ../cbindgen/MAIN.thx <path-to>/raylib.h

$ with RAYLIB

# Spawn a program (fire-and-forget) via libc. The `&` in the command returns at
# once. Not part of raylib, so it stays a local `@extern`.
$ system : Str -> Int = @extern "C" "system" "libc"

# -- palette (ordinary struct literals, passed to raylib by value) -----------
$ bg        : Color = Color.{ .r = 24,  .g = 24,  .b = 32,  .a = 255 }
$ btn_col   : Color = Color.{ .r = 45,  .g = 48,  .b = 66,  .a = 255 }
$ hover_col : Color = Color.{ .r = 70,  .g = 82,  .b = 128, .a = 255 }
$ text_col  : Color = Color.{ .r = 232, .g = 232, .b = 240, .a = 255 }

# -- the launchable programs (edit this list) --------------------------------
$ App : @struct = label: Str, cmd: Str,

$ apps : @list App =
	[ App.{ .label = "Terminal", .cmd = "xterm &" }
	, App.{ .label = "Files",    .cmd = "xdg-open . &" }
	, App.{ .label = "Browser",  .cmd = "firefox &" } ]

# -- layout ------------------------------------------------------------------
$ pad   : @int32 = 20
$ top   : @int32 = 56
$ btn_w : @int32 = 380
$ btn_h : @int32 = 48
$ gap   : @int32 = 12

$ button_y : @int32 -> @int32 = \i = top + i * (btn_h + gap)

# Is (mx, my) inside the axis-aligned box at (x, y) of size (w, h)?
$ in_box : @int32 -> @int32 -> @int32 -> @int32 -> @int32 -> @int32 -> Int =
	\mx my x y w h =
		if mx >= x && mx ?< x + w && my >= y && my ?< y + h => 1 else 0

# -- rendering ---------------------------------------------------------------
$ draw_apps : @list App -> @int32 -> @int32 -> @int32 -> {} =
	\apps i mx my =
		is apps
			| [] => {}
			| a :: rest =>
				let y = button_y i,
				    hover = in_box mx my pad y btn_w btn_h,
				    col = if hover ?= 1 => hover_col else btn_col in
				drawRectangle { .p0 = pad, .p1 = y, .p2 = btn_w, .p3 = btn_h, .p4 = col } ;
				drawText { .p0 = a.label, .p1 = pad + 16, .p2 = y + 14, .p3 = 20, .p4 = text_col } ;
				draw_apps rest (i + 1) mx my

$ render : @int32 -> @int32 -> {} =
	\mx my =
		beginDrawing {} ;
		clearBackground bg ;
		drawText { .p0 = "Thrax Launcher", .p1 = pad, .p2 = 18, .p3 = 24, .p4 = text_col } ;
		draw_apps apps 0 mx my ;
		endDrawing {}

# On a click, find the button under the cursor and spawn its program.
$ click : @list App -> @int32 -> @int32 -> @int32 -> Int =
	\apps i mx my =
		is apps
			| [] => 0
			| a :: rest =>
				let y = button_y i in
				if in_box mx my pad y btn_w btn_h ?= 1 => system a.cmd
				else click rest (i + 1) mx my

# -- frame loop --------------------------------------------------------------
$ loop : {} -> {} =
	if windowShouldClose {} ?= 0 =>
		let mx = getMouseX {},
		    my = getMouseY {} in
		render mx my ;
		(if isMouseButtonPressed mouse_button_left ?= 1
			=> let _ = click apps 0 mx my in {}
			else {}) ;
		loop {}
	else closeWindow {}

$ main : {} -> <| e> Int = \u =
	initWindow { .p0 = 420, .p1 = 260, .p2 = "Thrax Launcher" } ;
	setTargetFPS 60 ;
	loop {} ;
	0
